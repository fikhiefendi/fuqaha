---
// Small map of one jurist's places (Leaflet from the CDN).
interface Props {
  points: { name: string; lat: number; lng: number; approx: boolean; roles: string }[];
  label: string;
}
const { points, label } = Astro.props;
---

{
  points.length > 0 && (
    <>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
      <script is:inline src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" />
      <div class="mini-map" data-mini-map={JSON.stringify(points)} role="img" aria-label={label} />
    </>
  )
}

<style>
  .mini-map {
    height: 240px;
    background: #eef1f3;
  }
</style>

<script>
  declare const L: any;
  document.querySelectorAll<HTMLElement>('[data-mini-map]').forEach((el) => {
    const pts = JSON.parse(el.dataset.miniMap ?? '[]') as { name: string; lat: number; lng: number; approx: boolean; roles: string }[];
    const map = L.map(el, { zoomControl: false, attributionControl: true, scrollWheelZoom: false });
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
      attribution: 'Tiles © Esri · al-Ṯurayyā',
      maxZoom: 9,
    }).addTo(map);
    const layer = L.featureGroup(
      pts.map((p) =>
        L.circleMarker([p.lat, p.lng], { radius: 6, weight: 2, color: '#1f4a6e', fillColor: '#1f4a6e', fillOpacity: p.approx ? 0.25 : 0.8, dashArray: p.approx ? '3 3' : null })
          .bindTooltip(`${p.name} · ${p.roles}`, { direction: 'top', offset: [0, -6] }),
      ),
    ).addTo(map);
    if (pts.length === 1) map.setView([pts[0].lat, pts[0].lng], 5);
    else map.fitBounds(layer.getBounds().pad(0.4), { maxZoom: 6 });
  });
</script>
