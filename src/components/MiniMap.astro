---
// Small parchment map of one jurist's places, joined in life order.
interface Props {
  points: { name: string; nameAr: string; lat: number; lng: number; approx: boolean; roles: string }[];
  label: string;
  rtl?: boolean;
}
const { points, label, rtl = false } = Astro.props;
---

{points.length > 0 && <div class="mini-map" data-mini-map={JSON.stringify({ points, rtl })} role="img" aria-label={label} />}

<style>
  .mini-map {
    height: 260px;
  }
</style>

<script>
  import { atlasMap, cityIcon, cityLabel, L, route } from '../lib/atlas';

  type Pt = { name: string; nameAr: string; lat: number; lng: number; approx: boolean; roles: string };
  document.querySelectorAll<HTMLElement>('[data-mini-map]').forEach((el) => {
    const { points: pts, rtl } = JSON.parse(el.dataset.miniMap ?? '{}') as { points: Pt[]; rtl: boolean };
    const map = atlasMap(el, { scrollWheelZoom: false, attributionControl: true, minZoom: 2 });
    if (pts.length > 1) route(pts.map((p) => [p.lat, p.lng])).addTo(map);
    const layer = L.featureGroup(
      pts.map((p) =>
        L.marker([p.lat, p.lng], { icon: cityIcon(3, { approx: p.approx }) }).bindTooltip(`${cityLabel(p.name, p.nameAr, rtl)}<span>${p.roles}</span>`, {
          permanent: pts.length <= 4,
          direction: 'bottom',
          offset: [0, 6],
          className: 'city-name',
        }),
      ),
    ).addTo(map);
    if (pts.length === 1) map.setView([pts[0].lat, pts[0].lng], 5);
    else map.fitBounds(layer.getBounds().pad(0.5), { maxZoom: 6 });
  });
</script>
