---
import Base from '../layouts/Base.astro';
import PageHead from './PageHead.astro';
import { useT, type Lang, type UIKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: UIKey;
  lead: UIKey;
}
const { lang, title, lead } = Astro.props;
const t = useT(lang);
---

<Base lang={lang} title={t(title)} description={t(lead)}>
  <div class="wrap">
    <PageHead kicker={t('soon')} title={t(title)} lead={t(lead)} />
  </div>
</Base>
