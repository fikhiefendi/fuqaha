---
// Full-screen home hero: photographs that crossfade, headline on one side,
// a numbered pager with a progress rule and the photo's caption at the foot.
import Cover from './Cover.astro';
import { type FeatureItem } from '../lib/entries';
import { LANG_META, useT, type Lang, type UIKey } from '../i18n/ui';
import { href } from '../lib/url';
import Mark from './Mark.astro';

interface Props {
  lang: Lang;
  items: FeatureItem[];
  interval?: number;
}
const { lang, items, interval = 7000 } = Astro.props;
const t = useT(lang);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="hero" aria-roledescription="carousel" aria-label={t('slider.label')} data-hero data-interval={interval} style={`--interval:${interval}ms`}>
  {
    items.map((item, i) => (
      <article
        class="slide"
        data-active={i === 0 ? '' : undefined}
        aria-roledescription="slide"
        aria-label={`${i + 1} / ${items.length}`}
        aria-hidden={i === 0 ? undefined : 'true'}
      >
        <div class="bg">
          <Cover
            seed={item.seed}
            image={item.image ?? item.photo?.src}
            alt={item.imageAlt ?? item.photo?.caption[lang]}
            label={item.label}
            eager={i === 0}
          />
        </div>
        <div class="wrap content">
          <span class="kicker">{item.kicker}</span>
          {item.label && item.kind === 'scholar' && (
            <p class="ar-name" lang="ar" dir="rtl">
              {item.label}
            </p>
          )}
          <h2 lang={item.titleLang} dir={LANG_META[item.titleLang].dir}>
            {item.title}
          </h2>
          {item.summary && <p class="summary">{item.summary}</p>}
          <div class="cta">
            <span class="cta-line" aria-hidden="true"></span>
            <a href={item.href} class="cta-btn" tabindex={i === 0 ? undefined : '-1'}>
              {t('details')}
            </a>
          </div>
        </div>
        {item.photo && <p class="caption">{item.photo.caption[lang]}</p>}
      </article>
    ))
  }

  <a href={href(lang, 'about/')} class="badge" aria-label={t('nav.about')}>
    <svg viewBox="0 0 120 120" aria-hidden="true">
      <defs><path id="badge-circle" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0"></path></defs>
      <text><textPath href="#badge-circle" textLength="286" lengthAdjust="spacing">{t('hero.badge' as UIKey)}</textPath></text>
    </svg>
    <span class="badge-mark"><Mark size={30} /></span>
  </a>

  <a href="#main-sections" class="notch" aria-label="↓">
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="m3 5 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
  </a>

  {
    items.length > 1 && (
      <div class="wrap pager">
        <span class="count" aria-hidden="true">
          <b data-current>01</b> / {pad(items.length)}
        </span>
        <span class="progress" aria-hidden="true">
          <span data-bar />
        </span>
        <button type="button" class="step" data-step="-1" aria-label={t('slider.prev')}>
          <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H4m5-5-5 5 5 5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
        <button type="button" class="step" data-step="1" aria-label={t('slider.next')}>
          <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
      </div>
    )
  }
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    height: 100vh;
    min-height: 580px;
    max-height: 960px;
    overflow: hidden;
    background: #16130f;
    color: #fff;
  }
  .slide {
    grid-area: 1 / 1;
    position: relative;
    display: flex;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.1s ease,
      visibility 0s linear 1.1s;
  }
  .slide[data-active] {
    opacity: 1;
    visibility: visible;
    transition: opacity 1.1s ease;
  }
  .bg {
    position: absolute;
    inset: 0;
  }
  .bg :global(.cover) {
    transform: scale(1.06);
    transition: transform 10s ease-out;
  }
  .slide[data-active] .bg :global(.cover) {
    transform: scale(1);
  }
  /* Warm dark wash so white type stays legible on any photograph */
  .bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgb(22 17 11 / 0.9), rgb(22 17 11 / 0.62) 50%, rgb(22 17 11 / 0.3)),
      linear-gradient(to top, rgb(22 17 11 / 0.75), transparent 45%);
  }
  :root[dir='rtl'] .bg::after {
    background:
      linear-gradient(to left, rgb(22 17 11 / 0.9), rgb(22 17 11 / 0.62) 50%, rgb(22 17 11 / 0.3)),
      linear-gradient(to top, rgb(22 17 11 / 0.75), transparent 45%);
  }
  .content {
    position: relative;
    padding-block: var(--header-h) 110px;
  }
  .content > * {
    max-width: 680px;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-block-end: 16px;
    font: 500 0.82rem var(--sans);
    letter-spacing: 0.04em;
    color: rgb(255 255 255 / 0.85);
  }
  .kicker::before {
    content: '';
    width: 28px;
    height: 2px;
    background: #d9765c;
  }
  .ar-name {
    margin-block-end: 6px;
    font: 700 clamp(1.4rem, 2.6vw, 2rem) / 1.5 var(--arabic);
    color: #ecd9b0;
  }
  h2 {
    color: #fff;
    font-size: clamp(2.2rem, 5.2vw, 4.2rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  h2:lang(ar) {
    font-family: var(--arabic);
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: 0;
  }
  .summary {
    margin-block: 18px 30px;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.86);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* A rule leading into an outlined button */
  .cta {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .cta-line {
    width: 110px;
    height: 1px;
    background: rgb(255 255 255 / 0.75);
  }
  .cta-btn {
    padding: 11px 26px;
    border: 1.5px solid #fff;
    color: #fff;
    font: 500 0.88rem var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      background 0.25s,
      color 0.25s;
  }
  :root[lang='ar'] .cta-btn {
    letter-spacing: 0;
    font-size: 1rem;
  }
  .cta-btn:hover {
    background: #fff;
    color: var(--ink);
  }

  /* Slowly turning seal */
  .badge {
    position: absolute;
    z-index: 3;
    inset-block-start: calc(var(--header-h) + 18px);
    inset-inline-end: 32px;
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    color: #fff;
  }
  .badge svg {
    position: absolute;
    inset: 0;
    animation: turn 36s linear infinite;
  }
  .badge text {
    font: 600 9.6px var(--sans);
    fill: currentColor;
  }
  :root[lang='ar'] .badge text {
    font: 700 12px var(--arabic);
    letter-spacing: 0;
  }
  .badge-mark {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    color: #ecd9b0;
  }
  .badge:hover .badge-mark {
    background: rgb(255 255 255 / 0.12);
  }
  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }

  /* Notch at the foot of the hero */
  .notch {
    position: absolute;
    z-index: 3;
    inset-block-end: 0;
    left: 50%;
    display: grid;
    place-items: end center;
    width: 48px;
    height: 24px;
    margin-left: -24px;
    padding-block-end: 1px;
    background: var(--bg);
    clip-path: polygon(0 100%, 50% 0, 100% 100%);
    color: var(--ink);
  }

  .caption {
    position: absolute;
    inset-block-end: 30px;
    inset-inline-end: 32px;
    max-width: 38ch;
    font: italic 400 0.76rem/1.45 var(--sans);
    color: rgb(255 255 255 / 0.7);
    text-align: end;
  }

  .pager {
    position: absolute;
    z-index: 3;
    inset-block-end: 26px;
    inset-inline: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    pointer-events: none;
  }
  .pager > * {
    pointer-events: auto;
  }
  .count {
    font: 400 0.85rem var(--sans);
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.7);
  }
  .count b {
    font-weight: 600;
    color: #fff;
  }
  .progress {
    position: relative;
    width: 120px;
    height: 2px;
    background: rgb(255 255 255 / 0.25);
    overflow: hidden;
  }
  .progress span {
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }
  :root[dir='rtl'] .progress span {
    transform-origin: right;
  }
  .progress span.run {
    animation: fill var(--interval) linear forwards;
  }
  @keyframes fill {
    to {
      transform: scaleX(1);
    }
  }
  .step {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: background 0.2s;
  }
  .step:hover {
    background: rgb(255 255 255 / 0.15);
  }
  :root[dir='rtl'] .step svg {
    transform: scaleX(-1);
  }

  @media (max-width: 900px) {
    .badge {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .caption {
      display: none;
    }
    .cta-line {
      width: 44px;
    }
    .content > * {
      max-width: 100%;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-hero]')) {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const current = root.querySelector<HTMLElement>('[data-current]');
    const bar = root.querySelector<HTMLElement>('[data-bar]');
    const interval = Number(root.dataset.interval) || 7000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rtl = document.documentElement.dir === 'rtl';
    let index = 0;
    let timer: number | undefined;

    const restartBar = (run: boolean) => {
      if (!bar) return;
      bar.classList.remove('run');
      void bar.offsetWidth;
      bar.classList.toggle('run', run);
    };
    const show = (i: number) => {
      index = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        const on = n === index;
        s.toggleAttribute('data-active', on);
        on ? s.removeAttribute('aria-hidden') : s.setAttribute('aria-hidden', 'true');
        s.querySelectorAll('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
      if (current) current.textContent = String(index + 1).padStart(2, '0');
    };
    const stop = () => {
      window.clearInterval(timer);
      restartBar(false);
    };
    const start = () => {
      stop();
      if (reduced || slides.length < 2) return;
      restartBar(true);
      timer = window.setInterval(() => {
        show(index + 1);
        restartBar(true);
      }, interval);
    };

    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => {
        show(index + Number(b.dataset.step));
        start();
      }),
    );
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    let x0 = 0;
    root.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    root.addEventListener('pointerup', (e) => {
      const dx = e.clientX - x0;
      if (Math.abs(dx) < 50) return;
      show(index + ((rtl ? dx > 0 : dx < 0) ? 1 : -1));
      start();
    });

    start();
  }
</script>
