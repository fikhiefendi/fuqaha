---
import { SITE } from '../site.config';
import { LANG_META, LOCALES, NAV, useT, type Lang } from '../i18n/ui';
import { href } from '../lib/url';
import Mark from './Mark.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
const heads = {
  tr: ['Bölümler', 'Site', 'Diller'],
  en: ['Sections', 'Site', 'Languages'],
  ar: ['الأقسام', 'الموقع', 'اللغات'],
}[lang];
---

<footer>
  <div class="wrap cols">
    <div class="about">
      <a href={href(lang)} class="brand">
        <span class="mark"><Mark size={28} /></span>
        <span>{SITE.name}</span>
        <span class="brand-ar" lang="ar">{SITE.nameAr}</span>
      </a>
      <p>{t('tagline')}</p>
    </div>
    <div>
      <h3>{heads[0]}</h3>
      <ul>{NAV.slice(0, 4).map((item) => <li><a href={href(lang, item.path)}>{t(item.key)}</a></li>)}</ul>
    </div>
    <div>
      <h3>{heads[1]}</h3>
      <ul>
        <li><a href={href(lang, 'about/')}>{t('nav.about')}</a></li>
        <li><a href={href(lang, 'contribute/')}>{t('contribute.title')}</a></li>
        <li><a href={href(lang, 'search/')}>{t('nav.search')}</a></li>
        <li><a href={href(lang, 'credits/')}>{t('credits.title')}</a></li>
      </ul>
    </div>
    <div>
      <h3>{heads[2]}</h3>
      <ul>{LOCALES.map((l) => <li><a href={href(l)} lang={l}>{LANG_META[l].name}</a></li>)}</ul>
    </div>
  </div>
  <div class="wrap bottom">
    <p class="note">{t('footer.note')}</p>
    <p class="row">
      <span>© {year} {SITE.name}</span>
      <a href="#top" class="to-top" data-to-top>{t('toTop')} ↑</a>
    </p>
  </div>
</footer>

<style>
  footer {
    background: var(--soft);
    border-block-start: 1px solid var(--rule);
    padding-block: 56px 24px;
    font-size: 0.85rem;
  }
  .cols {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 820px) {
    .cols {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font: 600 1.3rem var(--serif-latin);
  }
  .mark {
    display: grid;
    place-items: center;
    color: var(--rubric);
  }
  .brand-ar {
    padding-inline-start: 10px;
    border-inline-start: 1px solid var(--rule);
    font: 700 1.15rem var(--arabic);
  }
  .about p {
    margin-block-start: 14px;
    max-width: 34ch;
  }
  h3 {
    font-size: 0.95rem;
    margin-block-end: 14px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    margin-block-start: 8px;
  }
  li a:hover {
    color: var(--accent);
  }
  .bottom {
    display: grid;
    gap: 8px;
    margin-block-start: 40px;
    padding-block-start: 20px;
    border-block-start: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.78rem;
  }
  .note {
    max-width: 90ch;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .to-top {
    color: var(--ink);
  }
  .to-top:hover {
    color: var(--rubric);
  }
</style>

<script>
  document.querySelector('[data-to-top]')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
