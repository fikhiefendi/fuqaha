---
// The site mark: an eight-pointed star (khātam) drawn from two overlapping squares.
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
  <rect x="7" y="7" width="18" height="18"></rect>
  <rect x="7" y="7" width="18" height="18" transform="rotate(45 16 16)"></rect>
  <circle cx="16" cy="16" r="3.2" fill="currentColor" stroke="none"></circle>
</svg>
