---
import Base from '../../../layouts/Base.astro';
import { getMapData, ROLES } from '../../../lib/mapdata';
import { centuryLabel } from '../../../lib/scholars';
import { langPaths, useT, type Lang, type UIKey } from '../../../i18n/ui';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const data = await getMapData(lang);
const centuries = [...new Set(data.scholars.map((s) => s.c).filter(Boolean))].sort((a, b) => a - b);
const payload = {
  ...data,
  centuries: centuries.map((c) => [c, centuryLabel(c, lang), centuryLabel(c, 'ar')]),
  t: {
    all: t('map.allCenturies'),
    play: t('map.play'),
    stop: t('map.stop'),
    places: t('map.places'),
    scholars: t('map.scholars'),
    pick: t('map.pick'),
    gazetteerId: t('map.gazetteerId'),
    approx: t('map.legendApprox'),
  },
  rtl: lang === 'ar',
};
---

<Base lang={lang} title={t('nav.map')} description={t('map.lead')}>
  <div class="map-page">
    <aside class="panel">
      <header>
        <h1>{t('nav.map')}</h1>
        <p class="lead">{t('map.lead')}</p>
      </header>

      <form class="controls" data-controls onsubmit="return false">
        <div class="field">
          <div class="row">
            <span class="label">{t('map.century')}</span>
            <output class="century" data-century-label>{t('map.allCenturies')}</output>
          </div>
          <input type="range" name="c" min="0" max={centuries.length} value="0" step="1" aria-label={t('map.century')} />
          <button type="button" class="btn small plain play" data-play>{t('map.play')}</button>
        </div>

        <fieldset class="field">
          <legend class="label">{t('map.roles')}</legend>
          <div class="roles">
            {
              ROLES.map((r) => (
                <label class="chip">
                  <input type="checkbox" name="role" value={r} checked />
                  <span>{t(`role.${r}` as UIKey)}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <label class="field">
          <span class="label">{t('map.searchPlace')}</span>
          <input type="search" name="q" placeholder={t('map.searchPlaceholder')} list="place-names" autocomplete="off" />
          <datalist id="place-names">
            {data.places.map((p) => <option value={p.name} />)}
          </datalist>
        </label>

        <p class="stats" aria-live="polite" data-stats></p>
      </form>

      <section class="detail" data-detail>
        <p class="hint">{t('map.pick')}</p>
      </section>

      <footer class="legend">
        <p class="label">{t('map.legend')}</p>
        <p><span class="dot"></span> {t('map.legendGazetteer')}</p>
        <p><span class="dot hollow"></span> {t('map.legendApprox')}</p>
        <p class="attr">
          {t('map.attribution')}
          <a href="https://github.com/althurayya/althurayya.github.io" rel="noopener" target="_blank">al-Ṯurayyā</a> ·
          <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener" target="_blank">CC BY 4.0</a>
        </p>
      </footer>
    </aside>

    <div class="map-wrap">
      <div class="map" id="map" role="region" aria-label={t('nav.map')}></div>
      <div class="cartouche" data-cartouche aria-hidden="true">
        <span class="c-ar" lang="ar">الفقهاء في البلدان</span>
        <span class="c-sub" data-cartouche-sub>{t('map.allCenturies')}</span>
      </div>
    </div>
  </div>

  <script type="application/json" id="map-data" set:html={JSON.stringify(payload)} />
</Base>

<style>
  .map-page {
    display: grid;
    height: calc(100vh - var(--header-h));
    min-height: 560px;
  }
  @media (min-width: 900px) {
    .map-page {
      grid-template-columns: 380px 1fr;
    }
  }
  .panel {
    overflow-y: auto;
    padding: 28px 24px;
    background: var(--surface);
    border-inline-end: 1px solid var(--rule);
  }
  h1 {
    font-size: 1.7rem;
  }
  .lead {
    margin-block-start: 6px;
    font-size: 0.88rem;
  }
  .controls {
    display: grid;
    gap: 18px;
    margin-block: 22px;
    padding: 18px;
    background: var(--soft);
  }
  .field {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .label {
    font: 700 0.72rem var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }
  :root[lang='ar'] .label {
    letter-spacing: 0;
    font-size: 0.85rem;
  }
  .century {
    font: 700 0.95rem var(--serif-latin);
    color: var(--accent);
  }
  :root[lang='ar'] .century {
    font-family: var(--arabic);
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
  }
  .play {
    justify-self: start;
  }
  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    position: relative;
    cursor: pointer;
  }
  .chip input {
    position: absolute;
    opacity: 0;
  }
  .chip span {
    display: inline-block;
    padding: 5px 10px;
    border: 1px solid var(--rule);
    background: var(--surface);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .chip input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  input[type='search'] {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--rule);
    font: inherit;
    font-size: 0.92rem;
    border-radius: 0;
  }
  .stats {
    font-size: 0.85rem;
  }
  .stats :global(strong) {
    color: var(--accent);
  }

  .detail {
    min-height: 120px;
  }
  .hint {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .detail :global(h2) {
    font-size: 1.3rem;
  }
  .detail :global(.ar) {
    font: 700 1.2rem/1.6 var(--arabic);
    color: var(--accent);
  }
  .detail :global(.sub) {
    font-size: 0.8rem;
    color: var(--muted);
    margin-block: 4px 12px;
  }
  .detail :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .detail :global(li) {
    padding-block: 9px;
    border-block-end: 1px solid var(--rule);
  }
  .detail :global(li a) {
    display: grid;
    gap: 2px;
  }
  .detail :global(li a:hover .n) {
    color: var(--accent);
  }
  .detail :global(.n) {
    font: 700 0.92rem/1.4 var(--serif);
    color: var(--ink);
  }
  .detail :global(.m) {
    font-size: 0.76rem;
    color: var(--muted);
  }

  .legend {
    margin-block-start: 26px;
    padding-block-start: 16px;
    border-block-start: 1px solid var(--rule);
    font-size: 0.78rem;
  }
  .legend p + p {
    margin-block-start: 6px;
  }
  .dot {
    display: inline-block;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: -1px;
  }
  .dot.hollow {
    background: var(--surface);
    border: 2px dashed var(--accent);
  }
  .attr {
    color: var(--muted);
    line-height: 1.6;
  }
  .attr a {
    color: var(--accent);
    text-decoration: underline;
  }

  .map-wrap {
    position: relative;
    min-height: 420px;
  }
  .map {
    position: absolute;
    inset: 0;
  }
  /* Title cartouche in the manner of an atlas sheet */
  .cartouche {
    position: absolute;
    z-index: 500;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 10px 34px 12px;
    background: rgb(244 234 211 / 0.92);
    border: 1px solid rgb(94 29 18 / 0.45);
    outline: 1px solid rgb(94 29 18 / 0.25);
    outline-offset: 3px;
    border-radius: 40px / 50%;
    pointer-events: none;
    text-align: center;
  }
  .c-ar {
    font: 700 1.35rem/1.3 var(--arabic);
    color: #5e1d12;
  }
  .c-sub {
    font: italic 500 0.8rem var(--serif-latin);
    letter-spacing: 0.08em;
    color: #6b5a44;
  }
  :root[lang='ar'] .c-sub {
    font: 700 0.95rem var(--arabic);
    letter-spacing: 0;
  }
  :root[data-theme='dark'] .cartouche {
    background: rgb(42 34 23 / 0.92);
  }
  :root[data-theme='dark'] .c-ar {
    color: #e9c9a0;
  }
  @media (max-width: 899px) {
    .map-page {
      height: auto;
      grid-template-rows: 60vh auto;
    }
    .map-wrap {
      order: -1;
    }
    .cartouche {
      padding: 6px 18px 8px;
    }
    .c-ar {
      font-size: 1.05rem;
    }
  }
</style>

<script>
  import { atlasMap, cityIcon, cityLabel, compass, esc, L, labelThreshold, regionLabels, route, zoomButtons, type Region } from '../../../lib/atlas';

  type Data = {
    places: { id: string; name: string; nameAr: string; region: string; lat: number; lng: number; uri?: string; approx: boolean; links: [number, string[]][] }[];
    scholars: { name: string; ar: string; href: string; c: number; life: string; p: string[] }[];
    roleLabels: Record<string, string>;
    regions: Region[];
    centuries: [number, string, string][];
    t: Record<string, string>;
    rtl: boolean;
  };
  const data: Data = JSON.parse(document.getElementById('map-data')!.textContent!);
  const form = document.querySelector<HTMLFormElement>('[data-controls]')!;
  const detail = document.querySelector<HTMLElement>('[data-detail]')!;
  const stats = document.querySelector<HTMLElement>('[data-stats]')!;
  const centuryLabel = document.querySelector<HTMLElement>('[data-century-label]')!;
  const cartoucheSub = document.querySelector<HTMLElement>('[data-cartouche-sub]')!;
  const playBtn = document.querySelector<HTMLButtonElement>('[data-play]')!;
  const byId = new Map(data.places.map((p) => [p.id, p]));

  const map = atlasMap(document.getElementById('map')!).setView([33, 52], 4);
  zoomButtons(map);
  compass(map);
  regionLabels(map, data.regions, data.rtl);
  const journey = L.layerGroup().addTo(map);

  let selected: string | null = null;
  const markers = new Map<string, L.Marker>();
  data.places.forEach((p) => {
    const m = L.marker([p.lat, p.lng], { icon: cityIcon(1, { approx: p.approx }), riseOnHover: true });
    m.on('click', () => select(p.id));
    markers.set(p.id, m);
  });

  const state = () => {
    const d = new FormData(form);
    const idx = Number(d.get('c') ?? 0);
    return {
      century: idx ? data.centuries[idx - 1][0] : 0,
      roles: new Set(d.getAll('role') as string[]),
      q: String(d.get('q') ?? '').trim().toLocaleLowerCase(),
    };
  };

  const linksFor = (p: Data['places'][number], s: ReturnType<typeof state>) =>
    p.links.filter(([i, roles]) => (!s.century || data.scholars[i].c === s.century) && roles.some((r) => s.roles.has(r)));

  const render = () => {
    const s = state();
    const cent = s.century ? data.centuries.find(([c]) => c === s.century)! : null;
    centuryLabel.textContent = cent ? cent[1] : data.t.all;
    cartoucheSub.textContent = cent ? (data.rtl ? cent[2] : cent[1]) : data.t.all;
    const people = new Set<number>();
    let nPlaces = 0;
    data.places.forEach((p) => {
      const links = linksFor(p, s);
      const m = markers.get(p.id)!;
      const matchQ = !s.q || p.name.toLocaleLowerCase().includes(s.q) || p.nameAr.includes(s.q);
      if (links.length && matchQ) {
        m.setIcon(cityIcon(links.length, { approx: p.approx, on: p.id === selected }));
        m.unbindTooltip();
        const big = links.length >= labelThreshold(map.getZoom()) || p.id === selected;
        m.bindTooltip(cityLabel(p.name, p.nameAr, data.rtl), {
          permanent: big,
          direction: 'bottom',
          offset: [0, 6],
          className: 'city-name',
        });
        if (!map.hasLayer(m)) m.addTo(map);
        links.forEach(([i]) => people.add(i));
        nPlaces++;
      } else if (map.hasLayer(m)) {
        map.removeLayer(m);
      }
    });
    stats.innerHTML = `<strong>${nPlaces}</strong> ${data.t.places} · <strong>${people.size}</strong> ${data.t.scholars}`;
    if (selected) showDetail(selected);
    if (s.q) {
      const hit = data.places.find((p) => p.name.toLocaleLowerCase().startsWith(s.q) || p.nameAr.startsWith(s.q));
      if (hit) map.panTo([hit.lat, hit.lng]);
    }
  };

  const drawJourney = (i: number | null) => {
    journey.clearLayers();
    if (i === null) return;
    const pts = data.scholars[i].p.map((id) => byId.get(id)).filter((p) => !!p);
    if (pts.length > 1) journey.addLayer(route(pts.map((p) => [p!.lat, p!.lng])));
  };

  const showDetail = (id: string) => {
    const p = byId.get(id)!;
    const links = linksFor(p, state());
    const items = links
      .sort((a, b) => data.scholars[a[0]].c - data.scholars[b[0]].c)
      .map(([i, roles]) => {
        const sc = data.scholars[i];
        const meta = [sc.life, roles.map((r) => data.roleLabels[r]).join(', ')].filter(Boolean).join(' · ');
        return `<li><a href="${sc.href}" data-i="${i}"><span class="n">${esc(sc.name)}</span><span class="m">${esc(meta)}</span></a></li>`;
      })
      .join('');
    const source = p.uri ? `${data.t.gazetteerId}: ${p.uri}` : data.t.approx;
    detail.innerHTML = `<h2>${esc(p.name)}</h2><p class="ar" lang="ar" dir="rtl">${esc(p.nameAr)}</p><p class="sub">${esc(p.region)} · ${links.length} ${data.t.scholars}<br>${esc(source)}</p><ul>${items}</ul>`;
    detail.querySelectorAll<HTMLAnchorElement>('[data-i]').forEach((a) => {
      const i = Number(a.dataset.i);
      a.addEventListener('mouseenter', () => drawJourney(i));
      a.addEventListener('focus', () => drawJourney(i));
      a.addEventListener('mouseleave', () => drawJourney(null));
    });
  };

  const select = (id: string) => {
    selected = id;
    render();
  };

  form.addEventListener('input', render);
  map.on('zoomend', render);

  let timer: number | undefined;
  const range = form.elements.namedItem('c') as HTMLInputElement;
  playBtn.addEventListener('click', () => {
    if (timer) {
      clearInterval(timer);
      timer = undefined;
      playBtn.textContent = data.t.play;
      return;
    }
    playBtn.textContent = data.t.stop;
    range.value = '1';
    render();
    timer = window.setInterval(() => {
      const next = Number(range.value) + 1;
      if (next > data.centuries.length) {
        clearInterval(timer);
        timer = undefined;
        playBtn.textContent = data.t.play;
        return;
      }
      range.value = String(next);
      render();
    }, 1600);
  });

  render();
</script>
