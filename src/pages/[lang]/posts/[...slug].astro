---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Cover from '../../../components/Cover.astro';
import { formatDate, getPosts, postImage } from '../../../lib/entries';
import { LANG_META, LOCALES, useT, type Lang } from '../../../i18n/ui';
import { href } from '../../../lib/url';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES) {
    for (const post of await getPosts(lang)) {
      paths.push({ params: { lang, slug: post.slug }, props: { post } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { post } = Astro.props;
const t = useT(lang);
const { entry } = post;
const { Content } = await render(entry);
const cover = postImage(entry, lang);
// When a translation is missing, the original is shown in its own direction.
const dir = LANG_META[post.lang].dir;
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.summary}
  index="post"
  image={cover?.src}
  ogType="article"
  jsonld={{ '@type': 'Article', headline: entry.data.title, description: entry.data.summary, datePublished: entry.data.date.toISOString().slice(0, 10), inLanguage: post.lang }}
>
  <PageHead title={entry.data.title} lead={entry.data.summary} back={{ href: href(lang, 'posts/'), label: t('post.back') }}>
    <p class="date">
      {formatDate(entry.data.date, lang)}
      {entry.data.tags.length > 0 && <> · {entry.data.tags.join(', ')}</>}
    </p>
  </PageHead>

  <article class="wrap article">
    <figure class="hero">
      <div class="frame"><Cover seed={post.slug} image={cover?.src} alt={cover?.alt} eager /></div>
      {cover?.photo && <figcaption>{cover.photo.caption[lang]}</figcaption>}
    </figure>
    {post.fallback && <p class="notice">{t('post.fallback')}</p>}
    <div class="prose" lang={post.lang} dir={dir}>
      <Content />
    </div>
  </article>
</Base>

<style>
  .date {
    margin-block-start: 14px;
  }
  .article {
    padding-block-end: 80px;
  }
  .hero {
    margin: 0 0 40px;
  }
  .frame {
    aspect-ratio: 21 / 8;
    overflow: hidden;
    background: var(--soft);
  }
  figcaption {
    margin-block-start: 10px;
    font: italic 400 0.8rem/1.5 var(--sans);
    color: var(--muted);
  }
  .notice {
    max-width: var(--measure);
    margin-block-end: 28px;
    padding: 12px 16px;
    border-inline-start: 3px solid var(--accent);
    background: var(--soft);
    font-size: 0.9rem;
  }
</style>
