---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { PHOTOS, licenseLabel } from '../../../lib/images';
import { langPaths, useT, type Lang } from '../../../i18n/ui';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
---

<Base lang={lang} title={t('credits.title')} description={t('credits.lead')}>
  <PageHead title={t('credits.title')} lead={t('credits.lead')} />

  <div class="wrap page">
    <ul class="grid">
      {
        PHOTOS.map((p) => (
          <li>
            <a href={p.credit.page} rel="noopener" target="_blank" class="thumb">
              <Image src={p.src} alt={p.caption[lang]} widths={[360, 640]} sizes="(min-width: 900px) 360px, 100vw" loading="lazy" />
            </a>
            <p class="caption">{p.caption[lang]}</p>
            <dl>
              <dt>{t('credits.artist')}</dt>
              <dd>{p.credit.artist}</dd>
              <dt>{lang === 'ar' ? 'الرخصة' : lang === 'en' ? 'Licence' : 'Lisans'}</dt>
              <dd>
                {p.credit.licenseUrl ? (
                  <a href={p.credit.licenseUrl} rel="noopener license" target="_blank">
                    {licenseLabel(p, lang)}
                  </a>
                ) : (
                  licenseLabel(p, lang)
                )}
              </dd>
            </dl>
            <a href={p.credit.page} rel="noopener" target="_blank" class="source">
              {t('credits.source')} · Wikimedia Commons
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .page {
    padding-block-end: 80px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 40px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .thumb {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--soft);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .thumb:hover :global(img) {
    transform: scale(1.04);
  }
  .caption {
    margin-block: 14px 10px;
    font: 600 0.98rem/1.45 var(--serif);
    color: var(--ink);
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 12px;
    margin: 0;
    font-size: 0.82rem;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  dd a,
  .source {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .source {
    display: inline-block;
    margin-block-start: 10px;
    font-size: 0.82rem;
  }
</style>
