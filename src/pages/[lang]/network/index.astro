---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { EDGES } from '../../../lib/network';
import { getScholars, lifeShort } from '../../../lib/scholars';
import { langPaths, useT, type Lang, type UIKey } from '../../../i18n/ui';
import { href } from '../../../lib/url';
import { photo } from '../../../lib/images';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const scholars = await getScholars();
const degree = new Map<string, number>();
EDGES.flat().forEach((id) => degree.set(id, (degree.get(id) ?? 0) + 1));
const nodes = scholars
  .filter((s) => degree.has(s.id))
  .map((s) => ({
    id: s.id,
    name: s.data.name[lang === 'ar' ? 'tr' : lang],
    ar: s.data.name.ar,
    life: lifeShort(s, lang),
    href: href(lang, `scholars/${s.id}/`),
    year: s.data.death.hijri ?? null,
    deg: degree.get(s.id)!,
  }));
const hub = [...nodes].sort((a, b) => b.deg - a.deg)[0].id;
const num = new Intl.NumberFormat(lang === 'ar' ? 'ar' : lang === 'en' ? 'en-GB' : 'tr-TR');
const k = (key: string) => t(key as UIKey);
const payload = {
  nodes,
  edges: EDGES,
  hub,
  rtl: lang === 'ar',
  t: {
    labels: { '-2': k('lineage.g-2'), '-1': k('lineage.g-1'), '1': k('lineage.g1'), '2': k('lineage.g2') },
    more: k('lineage.more'),
    hijri: k('network.hijri'),
    miladi: k('network.miladi'),
  },
};
---

<Base lang={lang} title={t('network.pageTitle')} description={t('network.pageLead')}>
  <PageHead title={t('network.pageTitle')} lead={t('network.pageLead')} photo={photo('library')} lang={lang} />

  <div class="wrap page">
    <div class="bar">
      <label class="find">
        <span class="visually-hidden">{t('network.search')}</span>
        <input type="search" list="net-names" placeholder={t('network.search')} data-find autocomplete="off" />
        <datalist id="net-names">{nodes.map((n) => <option value={lang === 'ar' ? n.ar : n.name} />)}</datalist>
      </label>
      <p class="meta">
        <strong>{num.format(nodes.length)}</strong> {t('network.nodes')} · <strong>{num.format(EDGES.length)}</strong> {t('network.edges')}
      </p>
    </div>

    <section class="block">
      <header class="block-head">
        <h2>{k('network.treeTitle')}</h2>
        <p>{k('network.treeLead')}</p>
      </header>
      <div class="focus-bar">
        <span class="focus-name" data-focus-name></span>
        <a class="focus-link" data-focus-link href="#">{k('network.openEntry')} →</a>
      </div>
      <div class="tree-wrap" data-tree></div>
    </section>

    <section class="block">
      <header class="block-head">
        <h2>{k('network.arcTitle')}</h2>
        <p>{k('network.arcLead')}</p>
      </header>
      <div class="arc-wrap" data-arc>
        <div class="tip" data-tip hidden></div>
      </div>
    </section>

    <p class="method meta">{t('network.method')}</p>

    <noscript>
      <ul>
        {nodes.map((n) => <li><a href={n.href}>{n.name}</a></li>)}
      </ul>
    </noscript>
  </div>

  <script type="application/json" id="net-data" set:html={JSON.stringify(payload)} />
</Base>

<style>
  .page {
    padding-block-end: 80px;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-block-end: 28px;
  }
  .find input {
    width: min(380px, 84vw);
    padding: 11px 16px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }
  .bar strong {
    color: var(--accent);
  }
  .block + .block {
    margin-block-start: 56px;
  }
  .block-head {
    max-width: 72ch;
    margin-block-end: 16px;
  }
  .block-head h2 {
    font-size: 1.5rem;
  }
  .block-head h2::before {
    content: '';
    display: block;
    width: 32px;
    height: 3px;
    margin-block-end: 12px;
    background: var(--rubric);
  }
  .block-head p {
    margin-block-start: 6px;
    font-size: 0.92rem;
  }
  .focus-bar {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-block-end: 10px;
  }
  .focus-name {
    font: 600 1.15rem var(--serif);
    color: var(--ink);
  }
  .focus-link {
    font-size: 0.88rem;
    color: var(--accent);
  }
  .tree-wrap,
  .arc-wrap {
    position: relative;
    overflow-x: auto;
    background: var(--soft);
    border: 1px solid var(--rule);
  }
  .tree-wrap :global(svg) {
    display: block;
    margin-inline: auto;
    max-width: none;
  }
  .arc-wrap :global(svg) {
    display: block;
    max-width: none;
  }
  .arc-wrap :global(.arc) {
    fill: none;
    stroke: var(--accent);
    stroke-opacity: 0.22;
    stroke-width: 1;
  }
  .arc-wrap :global(.arc.on) {
    stroke: var(--rubric);
    stroke-opacity: 0.95;
    stroke-width: 1.8;
  }
  .arc-wrap :global(.arc.off) {
    stroke-opacity: 0.06;
  }
  .arc-wrap :global(.dot) {
    fill: var(--accent);
    stroke: var(--soft);
    stroke-width: 1;
    cursor: pointer;
  }
  .arc-wrap :global(.dot.on) {
    fill: var(--rubric);
  }
  .arc-wrap :global(.dot.focus) {
    fill: var(--rubric);
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .arc-wrap :global(.axis line) {
    stroke: var(--rule);
  }
  .arc-wrap :global(.axis .base) {
    stroke: var(--muted);
  }
  .arc-wrap :global(.axis text) {
    font: 500 11px var(--sans);
    fill: var(--muted);
  }
  .arc-wrap :global(.axis .h text) {
    fill: var(--ink);
  }
  .arc-wrap :global(.axis .scale) {
    font: italic 600 11px var(--serif-latin);
    fill: var(--rubric);
  }
  .arc-wrap :global(.nlabel) {
    font: 700 13px 'Amiri', serif;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--soft);
    stroke-width: 4px;
    pointer-events: none;
  }
  .tip {
    position: absolute;
    z-index: 2;
    max-width: 280px;
    padding: 8px 12px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.82rem;
    line-height: 1.45;
    pointer-events: none;
  }
  .tip :global(.ar) {
    display: block;
    font: 700 1rem var(--arabic);
  }
  .method {
    max-width: 80ch;
    margin-block-start: 20px;
  }
</style>

<script>
  import { lineage, lineageSvg } from '../../../lib/lineage';

  type N = { id: string; name: string; ar: string; life: string; href: string; year: number | null; deg: number };
  const data = JSON.parse(document.getElementById('net-data')!.textContent!) as {
    nodes: N[];
    edges: [string, string][];
    hub: string;
    rtl: boolean;
    t: { labels: Record<string, string>; more: string; hijri: string; miladi: string };
  };
  const byId = new Map(data.nodes.map((n) => [n.id, n]));
  const treeEl = document.querySelector<HTMLElement>('[data-tree]')!;
  const arcEl = document.querySelector<HTMLElement>('[data-arc]')!;
  const tip = document.querySelector<HTMLElement>('[data-tip]')!;
  const focusName = document.querySelector<HTMLElement>('[data-focus-name]')!;
  const focusLink = document.querySelector<HTMLAnchorElement>('[data-focus-link]')!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const year = (id: string) => byId.get(id)?.year ?? null;

  /* ---------- Lineage tree ---------- */
  let focus = new URLSearchParams(location.search).get('focus') ?? data.hub;
  const drawTree = () => {
    const n = byId.get(focus);
    if (!n) return;
    focusName.textContent = data.rtl ? n.ar : `${n.name} · ${n.ar}`;
    focusLink.href = n.href;
    const labels = Object.fromEntries(Object.entries(data.t.labels).map(([g, v]) => [Number(g), v]));
    treeEl.innerHTML = lineageSvg(
      lineage(focus, data.edges, year),
      (id) => {
        const p = byId.get(id)!;
        return { name: p.name, ar: p.ar, life: p.life, href: p.href, year: p.year };
      },
      { self: focus, rtl: data.rtl, showLatin: !data.rtl, labels, moreLabel: (k) => data.t.more.replace('{n}', String(k)) },
    );
    const self = treeEl.querySelector<SVGGraphicsElement>('.nd.self rect');
    if (self) {
      const box = self.getBBox();
      treeEl.scrollLeft = box.x + box.width / 2 - treeEl.clientWidth / 2;
    }
    arcEl.querySelectorAll('.dot').forEach((d) => d.classList.toggle('focus', (d as SVGElement).dataset.id === focus));
  };
  // Clicking a box in the tree re-centres the tree instead of leaving the page.
  treeEl.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<SVGAElement>('a.nd');
    if (!a || a.classList.contains('self') || e.metaKey || e.ctrlKey) return;
    e.preventDefault();
    setFocus(a.dataset.id!);
  });
  const setFocus = (id: string) => {
    focus = id;
    history.replaceState(null, '', `?focus=${id}`);
    drawTree();
  };

  /* ---------- Arc diagram ---------- */
  const dated = data.nodes.filter((n) => n.year !== null);
  const minY = Math.floor(Math.min(...dated.map((n) => n.year!)) / 50) * 50 - 20;
  const maxY = Math.ceil(Math.max(...dated.map((n) => n.year!)) / 50) * 50 + 20;
  const K = 2.6;
  const PAD = 40;
  const W = PAD * 2 + (maxY - minY) * K;
  const X = (y: number) => (data.rtl ? W - PAD - (y - minY) * K : PAD + (y - minY) * K);
  const edges = data.edges.filter(([a, b]) => year(a) !== null && year(b) !== null);
  const maxSpan = Math.max(...edges.map(([a, b]) => Math.abs(X(year(a)!) - X(year(b)!))));
  const ARC_H = 300;
  const BASE = ARC_H + 30;

  // Stack jurists who died in the same years into small columns under the line.
  const pos = new Map<string, [number, number]>();
  const cols = new Map<number, number>();
  [...dated]
    .sort((a, b) => a.year! - b.year!)
    .forEach((n) => {
      const col = Math.round(X(n.year!) / 6);
      const k = cols.get(col) ?? 0;
      cols.set(col, k + 1);
      pos.set(n.id, [X(n.year!), BASE + 6 + k * 7]);
    });
  const H = BASE + 6 + Math.max(...cols.values()) * 7 + 70;

  const toMiladi = (h: number) => 622 + ((h - 1) * 354.367) / 365.2425;
  const fromMiladi = (m: number) => ((m - 622) * 365.2425) / 354.367 + 1;
  let axis = `<g class="axis"><line class="base" x1="${PAD / 2}" x2="${W - PAD / 2}" y1="${BASE}" y2="${BASE}"/>`;
  const axisY = H - 44;
  axis += `<text class="scale" x="${data.rtl ? W - 8 : 8}" y="${axisY}" text-anchor="${data.rtl ? 'end' : 'start'}">${esc(data.t.hijri)}</text>`;
  axis += `<text class="scale" x="${data.rtl ? W - 8 : 8}" y="${axisY + 22}" text-anchor="${data.rtl ? 'end' : 'start'}">${esc(data.t.miladi)}</text>`;
  for (let y = Math.ceil(minY / 50) * 50; y <= maxY; y += 50) {
    const x = X(y);
    const big = y % 100 === 0;
    axis += `<g class="h"><line x1="${x}" x2="${x}" y1="${big ? 0 : BASE - 10}" y2="${axisY - 14}" stroke-dasharray="${big ? '2 4' : ''}" opacity="${big ? 0.8 : 0.5}"/>${big ? `<text x="${x}" y="${axisY}" text-anchor="middle">${y}</text>` : ''}</g>`;
  }
  for (let m = Math.ceil(toMiladi(minY) / 100) * 100; m <= toMiladi(maxY); m += 100) {
    const x = X(fromMiladi(m));
    axis += `<g><line x1="${x}" x2="${x}" y1="${axisY + 8}" y2="${axisY + 12}"/><text x="${x}" y="${axisY + 22}" text-anchor="middle">${m}</text></g>`;
  }
  axis += '</g>';

  const arcs = edges
    .map(([a, b]) => {
      const [x1] = pos.get(a)!;
      const [x2] = pos.get(b)!;
      const rx = Math.abs(x2 - x1) / 2 || 3;
      const ry = Math.max(8, (rx / (maxSpan / 2)) * ARC_H);
      const [l, r] = x1 < x2 ? [x1, x2] : [x2, x1];
      return `<path class="arc" data-a="${a}" data-b="${b}" d="M${l} ${BASE}A${rx} ${ry} 0 0 1 ${r} ${BASE}"/>`;
    })
    .join('');
  const dots = dated
    .map((n) => {
      const [x, y] = pos.get(n.id)!;
      return `<circle class="dot" data-id="${n.id}" cx="${x}" cy="${y}" r="${Math.min(2.4 + Math.sqrt(n.deg) * 0.9, 6)}"/>`;
    })
    .join('');
  arcEl.insertAdjacentHTML('beforeend', `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">${axis}<g>${arcs}</g><g class="labels"></g><g>${dots}</g></svg>`);
  const labelsG = arcEl.querySelector('.labels')!;

  const hover = (id: string | null, e?: MouseEvent) => {
    const near = new Set<string>();
    arcEl.querySelectorAll<SVGPathElement>('.arc').forEach((p) => {
      const on = !!id && (p.dataset.a === id || p.dataset.b === id);
      if (on) near.add(p.dataset.a === id ? p.dataset.b! : p.dataset.a!);
      p.classList.toggle('on', on);
      p.classList.toggle('off', !!id && !on);
    });
    arcEl.querySelectorAll<SVGCircleElement>('.dot').forEach((d) => d.classList.toggle('on', !!id && (d.dataset.id === id || near.has(d.dataset.id!))));
    labelsG.innerHTML = id
      ? [id, ...near]
          .map((n) => {
            const p = pos.get(n);
            return p ? `<text class="nlabel" x="${p[0]}" y="${BASE - 8}" text-anchor="start" transform="rotate(-38 ${p[0]} ${BASE - 8})">${esc(byId.get(n)!.ar)}</text>` : '';
          })
          .join('')
      : '';
    tip.hidden = !id;
    if (id && e) {
      const n = byId.get(id)!;
      tip.innerHTML = `<span class="ar">${esc(n.ar)}</span>${data.rtl ? '' : esc(n.name) + '<br>'}${esc(n.life)}`;
      const box = arcEl.getBoundingClientRect();
      tip.style.left = `${Math.min(e.clientX - box.left + arcEl.scrollLeft + 14, arcEl.scrollWidth - 290)}px`;
      tip.style.top = `${Math.max(4, e.clientY - box.top - tip.offsetHeight - 14)}px`;
    }
  };
  arcEl.addEventListener('mouseover', (e) => {
    const d = (e.target as Element).closest<SVGCircleElement>('.dot');
    if (d) hover(d.dataset.id!, e);
  });
  arcEl.addEventListener('mouseout', (e) => {
    if ((e.target as Element).closest('.dot')) hover(null);
  });
  arcEl.addEventListener('click', (e) => {
    const d = (e.target as Element).closest<SVGCircleElement>('.dot');
    if (!d) return;
    setFocus(d.dataset.id!);
    treeEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  /* ---------- Search ---------- */
  const find = document.querySelector<HTMLInputElement>('[data-find]')!;
  find.addEventListener('change', () => {
    const q = find.value.trim();
    const hit = data.nodes.find((n) => n.name === q || n.ar === q);
    if (hit) setFocus(hit.id);
  });

  drawTree();
  const f = pos.get(focus);
  if (f) arcEl.scrollLeft = f[0] - arcEl.clientWidth / 2;
</script>
