---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import MiniMap from '../../../components/MiniMap.astro';
import { scholarPlaces } from '../../../lib/mapdata';
import { centuryLabel, dateLong, getScholars, scholarCentury, scholarSummary } from '../../../lib/scholars';
import { LOCALES, pick, useT, type Lang, type UIKey } from '../../../i18n/ui';
import { href } from '../../../lib/url';
import { MADHHABS, SITE } from '../../../site.config';
import { neighbours, refLink } from '../../../lib/network';
import { backdrop } from '../../../lib/images';
import { miladi } from '../../../lib/hijri';

export async function getStaticPaths() {
  const scholars = await getScholars();
  return LOCALES.flatMap((lang) =>
    scholars.map((s, i) => ({
      params: { lang, id: s.id },
      props: { s, prev: scholars[i - 1], next: scholars[i + 1], all: scholars },
    })),
  );
}

const lang = Astro.params.lang as Lang;
const { s, prev, next, all } = Astro.props;
const t = useT(lang);
const d = s.data;
const { Content } = await render(s);
const places = new Map((await getCollection('places')).map((p) => [p.id, p.data]));
const placeName = (id?: string) => (id ? (pick(places.get(id)?.name, lang) ?? id) : undefined);

const c = scholarCentury(s);
const birth = dateLong(d.birth, lang);
const death = dateLong(d.death, lang);
const facts: [string, string][] = [
  [t('scholar.birth'), [birth, placeName(d.birth?.place)].filter(Boolean).join(' — ')],
  [t('scholar.death'), [death ?? t('scholar.unknown'), placeName(d.death.place)].filter(Boolean).join(' — ')],
  [lang === 'ar' ? 'المذهب' : lang === 'en' ? 'School' : 'Mezhep', pick(MADHHABS[d.madhhab], lang) ?? ''],
  [t('scholars.century'), c ? centuryLabel(c, lang) : '—'],
];
const src = d.sources[0];
const points = [...scholarPlaces(s)]
  .filter(([pid]) => places.has(pid))
  .map(([pid, roles]) => {
    const p = places.get(pid)!;
    return {
      name: placeName(pid) ?? pid,
      lat: p.lat,
      lng: p.lng,
      approx: p.coordSource !== 'thurayya',
      roles: [...roles].map((r) => t(`role.${r}` as UIKey)).join(', '),
    };
  });
const title = lang === 'ar' ? d.name.ar : d.name[lang];

const byId = new Map(all.map((x) => [x.id, x]));
const nameOf = (id: string) => {
  const x = byId.get(id)!;
  return lang === 'ar' ? x.data.name.ar : x.data.name[lang];
};
const net = neighbours(s.id);
const lists = [
  { key: 'scholar.teachers', role: 'teachers', items: d.teachers },
  { key: 'scholar.students', role: 'students', items: d.students },
  { key: 'scholar.works', role: undefined, items: d.works.map((w) => w.ar) },
] as const;

const permalink = new URL(href(lang, `scholars/${s.id}/`), Astro.site).href;
const ldPlace = (id?: string) => {
  const p = id ? places.get(id) : undefined;
  return p && { '@type': 'Place', name: pick(p.name, lang), geo: { '@type': 'GeoCoordinates', latitude: p.lat, longitude: p.lng } };
};
const ceYear = (h?: number) => (h ? miladi(h).slice(0, 4).replace(/\D.*$/, '') : undefined);
const jsonld = {
  '@type': 'Person',
  name: title,
  alternateName: [...new Set([d.name.ar, d.name.tr, d.name.en])].filter((n) => n !== title),
  description: scholarSummary(s, lang),
  url: permalink,
  birthDate: ceYear(d.birth?.hijri),
  deathDate: ceYear(d.death.hijri),
  birthPlace: ldPlace(d.birth?.place),
  deathPlace: ldPlace(d.death.place),
  knowsAbout: lang === 'ar' ? 'الفقه الحنفي' : lang === 'en' ? 'Hanafi jurisprudence' : 'Hanefî fıkhı',
  subjectOf: { '@type': 'Book', name: src.book, author: { '@type': 'Person', name: src.author } },
};
const siteName = lang === 'ar' ? SITE.nameAr : SITE.name;
const srcRef =
  lang === 'ar'
    ? `${src.author}، ${src.book}، ص ${src.page}${src.entry ? `، رقم ${src.entry}` : ''}`
    : `${src.authorTr ?? src.author}, ${src.bookTr ?? src.book}, ${lang === 'en' ? 'p.' : 's.'} ${src.page}${src.entry ? `, ${lang === 'en' ? 'no.' : 'nr.'} ${src.entry}` : ''}`;
---

<Base lang={lang} title={title} description={scholarSummary(s, lang)} index="scholar" image={backdrop(s.id).src} jsonld={jsonld} ogType="profile">
  <PageHead title={title} back={{ href: href(lang, 'scholars/'), label: t('scholar.back') }}>
    {lang !== 'ar' && <p class="ar-name" lang="ar" dir="rtl">{d.name.ar}</p>}
    {d.fullNameAr && <p class="full" lang="ar" dir="rtl">{d.fullNameAr}</p>}
  </PageHead>

  <div class="wrap layout">
    <div class="main">
      {lang !== 'ar' && <p class="summary">{scholarSummary(s, lang)}</p>}

      <section class="text">
        <h2>{t('scholar.text')}</h2>
        <div class="prose ar-text" lang="ar" dir="rtl">
          <Content />
        </div>
      </section>

      {
        (d.teachers.length > 0 || d.students.length > 0 || d.works.length > 0) && (
          <section class="lists">
            {lists.map(
              ({ key, role, items }) =>
                items.length > 0 && (
                  <div>
                    <h3>{t(key)}</h3>
                    <ul lang="ar" dir="rtl">
                      {items.map((x, i) => {
                        const to = role && refLink(s.id, role, i);
                        return <li>{to ? <a href={href(lang, `scholars/${to}/`)}>{x}</a> : x}</li>;
                      })}
                    </ul>
                  </div>
                ),
            )}
            {t('scholar.namesNote') && <p class="meta note">{t('scholar.namesNote')}</p>}
          </section>
        )
      }

      {
        (net.teachers.length > 0 || net.students.length > 0) && (
          <section class="chain" data-pagefind-ignore>
            <h2>{t('network.title')}</h2>
            <p class="meta">{t('network.lead')}</p>
            <div class="chain-grid">
              {net.teachers.length > 0 && (
                <div class="tier">
                  <span class="tier-label">{t('scholar.teachers')}</span>
                  {net.teachers.map((id) => <a href={href(lang, `scholars/${id}/`)}>{nameOf(id)}</a>)}
                </div>
              )}
              <div class="tier self">
                <span>{title}</span>
              </div>
              {net.students.length > 0 && (
                <div class="tier">
                  <span class="tier-label">{t('scholar.students')}</span>
                  {net.students.map((id) => <a href={href(lang, `scholars/${id}/`)}>{nameOf(id)}</a>)}
                </div>
              )}
            </div>
            <a href={`${href(lang, 'network/')}?focus=${s.id}`} class="to-map">{t('network.open')} →</a>
          </section>
        )
      }

      <section class="cite" data-pagefind-ignore>
        <h2>{t('cite.title')}</h2>
        <div class="cite-box">
          <p class="label">ISNAD</p>
          <p class="ref" data-copy-src>
            “{title}”. <em>{siteName}</em>. {srcRef}. {t('cite.accessed')} <span data-today={lang}></span>. {permalink}
          </p>
          <button type="button" class="btn small plain" data-copy data-done={t('bib.copied')}>{t('bib.copy')}</button>
        </div>
        <div class="cite-box">
          <p class="label">Chicago</p>
          <p class="ref" data-copy-src>
            “{title}.” In <em>{siteName}</em>. {lang === 'en' ? 'Based on' : lang === 'ar' ? 'عن' : 'Kaynak:'} {srcRef}. {lang === 'tr' ? 'Erişim' : lang === 'ar' ? 'اطُّلع عليه في' : 'Accessed'} <span data-today={lang}></span>. {permalink}.
          </p>
          <button type="button" class="btn small plain" data-copy data-done={t('bib.copied')}>{t('bib.copy')}</button>
        </div>
        <p class="meta permalink">{t('cite.permalink')}: <a href={permalink}>{permalink}</a></p>
      </section>
    </div>

    <aside class="side">
      <dl class="facts">
        {
          facts.map(([k, v]) => (
            <div>
              <dt data-pagefind-ignore>{k}</dt>
              <dd>{v || '—'}</dd>
            </div>
          ))
        }
      </dl>

      {
        points.length > 0 && (
          <div class="box map-box">
            <h3>{t('scholar.places')}</h3>
            <MiniMap points={points} label={t('scholar.places')} />
            <ul class="places">
              {points.map((p) => (
                <li>
                  <span>{p.name}</span>
                  <span class="meta">{p.roles}</span>
                </li>
              ))}
            </ul>
            <a href={href(lang, 'map/')} class="to-map">{t('map.scholarPlaces')} →</a>
          </div>
        )
      }

      <div class="box source">
        <h3>{t('scholar.source')}</h3>
        <p lang="ar" dir="rtl" class="book">{src.book}</p>
        {lang !== 'ar' && src.bookTr && <p><em>{src.bookTr}</em></p>}
        <p>{lang === 'ar' ? src.author : (src.authorTr ?? src.author)}</p>
        {src.edition && <p class="meta">{src.edition}</p>}
        <p class="meta">
          {t('scholar.page')} {src.page}
          {src.entry && <> · {t('scholar.entry')} {src.entry}</>}
        </p>
      </div>
    </aside>
  </div>

  <nav class="wrap pager" aria-label="pager" data-pagefind-ignore>
    {prev ? <a href={href(lang, `scholars/${prev.id}/`)} class="prev">← <span lang="ar">{prev.data.name.ar}</span></a> : <span />}
    {next && <a href={href(lang, `scholars/${next.id}/`)} class="next"><span lang="ar">{next.data.name.ar}</span> →</a>}
  </nav>
</Base>

<style>
  .ar-name {
    margin-block-start: 10px;
    font: 700 1.6rem/1.5 var(--arabic);
    color: var(--accent);
    text-align: start;
  }
  .full {
    margin-block-start: 6px;
    font: 400 1.1rem/1.7 var(--arabic);
    color: var(--text);
    text-align: start;
  }
  :root:not([dir='rtl']) .ar-name,
  :root:not([dir='rtl']) .full {
    text-align: left;
  }
  .layout {
    display: grid;
    gap: 40px;
    padding-block-end: 48px;
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: 1fr 340px;
      gap: 56px;
    }
  }
  .summary {
    font: 400 1.12rem/1.8 var(--serif);
    color: var(--ink);
    margin-block-end: 36px;
    padding-inline-start: 18px;
    border-inline-start: 3px solid var(--rubric);
  }
  h2 {
    font-size: 1.2rem;
    margin-block-end: 16px;
  }
  .ar-text {
    max-width: none;
    font-family: var(--arabic);
    text-align: justify;
  }
  .ar-text :global(strong) {
    color: var(--accent);
  }
  .lists {
    display: grid;
    gap: 24px;
    margin-block-start: 44px;
    padding-block-start: 28px;
    border-block-start: 1px solid var(--rule);
  }
  @media (min-width: 700px) {
    .lists {
      grid-template-columns: repeat(3, 1fr);
    }
    .note {
      grid-column: 1 / -1;
    }
  }
  h3 {
    font-size: 0.95rem;
    margin-block-end: 10px;
  }
  .lists ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font: 400 1.08rem/1.7 var(--arabic);
    color: var(--ink);
  }
  .lists li + li {
    margin-block-start: 4px;
  }
  .lists a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .chain,
  .cite {
    margin-block-start: 44px;
    padding-block-start: 28px;
    border-block-start: 1px solid var(--rule);
  }
  .chain h2,
  .cite h2 {
    margin-block-end: 6px;
  }
  .chain-grid {
    display: grid;
    gap: 10px;
    margin-block: 18px 12px;
  }
  .tier {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 14px;
    background: var(--soft);
  }
  .tier-label {
    flex-basis: 100%;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .tier a {
    padding: 5px 12px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.88rem;
    color: var(--ink);
  }
  .tier a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .tier.self {
    justify-content: center;
    background: none;
    padding-block: 2px;
  }
  .tier.self span {
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }
  .cite-box {
    display: grid;
    gap: 10px;
    justify-items: start;
    margin-block-start: 14px;
    padding: 18px;
    background: var(--soft);
  }
  .cite-box .label {
    font: 600 0.72rem var(--sans);
    letter-spacing: 0.1em;
    color: var(--rubric);
  }
  .cite-box .ref {
    font-size: 0.92rem;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .permalink {
    margin-block-start: 12px;
    overflow-wrap: anywhere;
  }
  .permalink a {
    color: var(--accent);
  }

  .side {
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .facts {
    margin: 0;
    background: var(--accent);
    color: var(--on-accent);
    padding: 22px;
  }
  .facts div + div {
    margin-block-start: 14px;
    padding-block-start: 14px;
    border-block-start: 1px solid color-mix(in srgb, var(--on-accent) 20%, transparent);
  }
  dt {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  :root[lang='ar'] dt {
    letter-spacing: 0;
    font-size: 0.85rem;
  }
  dd {
    margin: 4px 0 0;
    font: 700 1rem/1.5 var(--serif);
  }
  .box {
    padding: 22px;
    background: var(--soft);
  }
  .map-box :global(.mini-map) {
    margin-block-end: 12px;
  }
  .to-map {
    display: inline-block;
    margin-block-start: 10px;
    font-size: 0.82rem;
    color: var(--accent);
  }
  .places {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .places li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: 6px;
    border-block-end: 1px solid var(--rule);
    color: var(--ink);
  }
  .source p + p {
    margin-block-start: 4px;
  }
  .book {
    font: 700 1.15rem/1.6 var(--arabic);
    color: var(--ink);
  }
  :root:not([dir='rtl']) .book {
    text-align: left;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 24px 72px;
    border-block-start: 1px solid var(--rule);
  }
  .pager a {
    color: var(--accent);
    font: 700 1.05rem var(--arabic);
  }
</style>

<script>
  const today = (lang: string) =>
    new Intl.DateTimeFormat({ tr: 'tr-TR', en: 'en-GB', ar: 'ar' }[lang] ?? 'tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date());
  document.querySelectorAll<HTMLElement>('[data-today]').forEach((el) => (el.textContent = today(el.dataset.today ?? 'tr')));
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const src = btn.parentElement?.querySelector('[data-copy-src]');
      if (!src) return;
      try {
        await navigator.clipboard.writeText((src.textContent ?? '').replace(/\s+/g, ' ').trim());
        const label = btn.textContent;
        btn.textContent = btn.dataset.done ?? '✓';
        setTimeout(() => (btn.textContent = label), 1500);
      } catch {
        /* clipboard unavailable: text stays selectable */
      }
    });
  });
</script>
