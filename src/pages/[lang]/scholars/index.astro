---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { photo } from '../../../lib/images';
import { getScholars, lifeShort, scholarCentury, centuryLabel } from '../../../lib/scholars';
import { getCollection } from 'astro:content';
import { langPaths, pick, useT, type Lang } from '../../../i18n/ui';
import { href } from '../../../lib/url';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const scholars = await getScholars();
const rows = scholars.map((s) => ({ s, c: scholarCentury(s) }));
const centuries = [...new Set(rows.map((r) => r.c).filter((c): c is number => !!c))].sort((a, b) => a - b);

const places = new Map((await getCollection('places')).map((p) => [p.id, pick(p.data.name, lang) ?? p.id]));
const collator = new Intl.Collator(lang === 'ar' ? 'ar' : lang === 'en' ? 'en' : 'tr');
const cityCount = new Map<string, number>();
for (const { s } of rows) {
  const id = s.data.death.place;
  if (id && places.has(id)) cityCount.set(id, (cityCount.get(id) ?? 0) + 1);
}
const cities = [...cityCount].sort((a, b) => collator.compare(places.get(a[0])!, places.get(b[0])!));

// First letter of the name as read on this page (Arabic ignores hamza forms).
const letterOf = (s: (typeof rows)[number]['s']) => {
  const name = lang === 'ar' ? s.data.name.ar : s.data.name[lang];
  const ch = name.replace(/^[^\p{L}]+/u, '').charAt(0);
  return lang === 'ar' ? ch.replace(/[أإآ]/, 'ا') : ch.toLocaleUpperCase(lang === 'tr' ? 'tr' : 'en');
};
const letters = [...new Set(rows.map(({ s }) => letterOf(s)))].sort(collator.compare);
const sortName = (s: (typeof rows)[number]['s']) => (lang === 'ar' ? s.data.name.ar : s.data.name[lang]);
---

<Base lang={lang} title={t('nav.scholars')} description={t('scholars.lead')}>
  <PageHead title={t('nav.scholars')} lead={t('scholars.sourceNote')} photo={photo('registan')} lang={lang} />

  <div class="wrap page">
    <form class="filters" role="search" data-filters onsubmit="return false">
      <label>
        <span>{t('scholars.searchLabel')}</span>
        <input type="search" name="q" placeholder={t('scholars.searchPlaceholder')} autocomplete="off" />
      </label>
      <label>
        <span>{t('scholars.century')}</span>
        <select name="c">
          <option value="">{t('scholars.allCenturies')}</option>
          {centuries.map((c) => <option value={c}>{centuryLabel(c, lang)}</option>)}
        </select>
      </label>
      <label>
        <span>{t('scholars.city')}</span>
        <select name="city">
          <option value="">{t('scholars.allCities')}</option>
          {cities.map(([id, n]) => <option value={id}>{places.get(id)} ({n})</option>)}
        </select>
      </label>
      <label>
        <span>{t('scholars.sort')}</span>
        <select name="sort">
          <option value="order">{t('scholars.sortOrder')}</option>
          <option value="death">{t('scholars.sortDeath')}</option>
          <option value="name">{t('scholars.sortName')}</option>
        </select>
      </label>
      <p class="count" aria-live="polite"><strong data-count>{rows.length}</strong> {t('scholars.count')}</p>
      <fieldset class="letters">
        <legend class="visually-hidden">{t('scholars.letters')}</legend>
        <label class="letter"><input type="radio" name="l" value="" checked /><span>{t('scholars.allLetters')}</span></label>
        {letters.map((l) => <label class="letter"><input type="radio" name="l" value={l} /><span>{l}</span></label>)}
      </fieldset>
    </form>
    <p class="to-network"><a href={href(lang, 'network/')}>{t('network.pageTitle')} →</a></p>

    <ol class="list">
      {
        rows.map(({ s, c }) => (
          <li
            data-c={c ?? ''}
            data-city={s.data.death.place ?? ''}
            data-l={letterOf(s)}
            data-death={s.data.death.hijri ?? 9999}
            data-name={sortName(s)}
            data-q={`${s.data.name.tr} ${s.data.name.en} ${s.data.name.ar} ${s.data.fullNameAr ?? ''}`.toLocaleLowerCase('tr')}>
            <a href={href(lang, `scholars/${s.id}/`)}>
              <span class="ar" lang="ar">{s.data.name.ar}</span>
              {lang !== 'ar' && <span class="name">{s.data.name[lang]}</span>}
              <span class="meta">
                {[lifeShort(s, lang), c ? centuryLabel(c, lang) : ''].filter(Boolean).join(' · ')}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="none" hidden data-none>{t('scholars.none')}</p>
  </div>
</Base>

<style>
  .page {
    padding-block-end: 80px;
  }
  .filters {
    display: grid;
    gap: 16px;
    align-items: end;
    margin-block-end: 28px;
    padding: 20px;
    background: var(--soft);
  }
  @media (min-width: 760px) {
    .filters {
      grid-template-columns: 2fr 1fr 1fr 1fr auto;
    }
  }
  .letters {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 12px 0 0;
    border: 0;
    border-block-start: 1px solid var(--rule);
  }
  .letter {
    display: block;
    cursor: pointer;
  }
  .letter input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .letter span {
    display: grid;
    place-items: center;
    min-width: 32px;
    height: 32px;
    padding-inline: 8px;
    border: 1px solid transparent;
    font: 500 0.9rem var(--sans);
    color: var(--ink);
  }
  :root[lang='ar'] .letter span {
    font: 700 1.1rem var(--arabic);
  }
  .letter:hover span {
    border-color: var(--rule);
    background: var(--surface);
  }
  .letter input:checked + span {
    background: var(--accent);
    color: var(--on-accent);
  }
  .letter input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .to-network {
    margin-block: -12px 20px;
    font-size: 0.88rem;
  }
  .to-network a {
    color: var(--accent);
  }
  label {
    display: grid;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--ink);
  }
  input,
  select {
    width: 100%;
    padding: 11px 12px;
    border: 1px solid var(--rule);
    background: var(--surface);
    font: inherit;
    font-size: 0.95rem;
    color: var(--ink);
    border-radius: 0;
  }
  input:focus,
  select:focus {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
  }
  .count {
    font-size: 0.85rem;
    padding-block-end: 10px;
  }
  .count strong {
    color: var(--accent);
    font-size: 1.1rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 28px;
  }
  @media (min-width: 900px) {
    .list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .list li {
    border-block-end: 1px solid var(--rule);
  }
  .list a {
    display: grid;
    gap: 2px;
    padding-block: 14px;
  }
  .list a:hover .name,
  .list a:hover .ar {
    color: var(--accent);
  }
  .ar {
    font: 700 1.15rem/1.6 var(--arabic);
    color: var(--ink);
  }
  .name {
    font: 700 0.95rem/1.4 var(--serif);
    color: var(--ink);
  }
  :root[lang='ar'] .ar {
    font-size: 1.3rem;
  }
  .none {
    padding: 24px 0;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const list = document.querySelector<HTMLOListElement>('.list');
  const items = [...document.querySelectorAll<HTMLLIElement>('.list li')];
  const count = document.querySelector('[data-count]');
  const none = document.querySelector<HTMLElement>('[data-none]');
  // Match without diacritics so "ebu hanife" finds "Ebû Hanîfe".
  const fold = (s: string) =>
    s
      .toLocaleLowerCase('tr')
      .normalize('NFD')
      .replace(/[̀-ًͯ-ٰٟ']/g, '')
      .replace(/[ıİ]/g, 'i')
      .replace(/[أإآ]/g, 'ا')
      .replace(/ى/g, 'ي')
      .replace(/ة/g, 'ه');
  const keys = items.map((li) => fold(li.dataset.q ?? ''));
  const collator = new Intl.Collator(document.documentElement.lang);
  const sorters: Record<string, (a: HTMLLIElement, b: HTMLLIElement) => number> = {
    order: (a, b) => items.indexOf(a) - items.indexOf(b),
    death: (a, b) => Number(a.dataset.death) - Number(b.dataset.death),
    name: (a, b) => collator.compare(a.dataset.name ?? '', b.dataset.name ?? ''),
  };
  const FIELDS = ['q', 'c', 'city', 'sort', 'l'];
  const apply = () => {
    if (!form || !list) return;
    const data = new FormData(form);
    const v = (k: string) => String(data.get(k) ?? '').trim();
    const q = fold(v('q'));
    let shown = 0;
    items.forEach((li, i) => {
      const ok =
        (!q || keys[i].includes(q)) &&
        (!v('c') || li.dataset.c === v('c')) &&
        (!v('city') || li.dataset.city === v('city')) &&
        (!v('l') || li.dataset.l === v('l'));
      li.hidden = !ok;
      if (ok) shown++;
    });
    list.append(...[...items].sort(sorters[v('sort') || 'order']));
    if (count) count.textContent = String(shown);
    if (none) none.hidden = shown > 0;
    const params = new URLSearchParams();
    FIELDS.forEach((k) => v(k) && !(k === 'sort' && v(k) === 'order') && params.set(k, v(k)));
    history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
  };
  const init = new URLSearchParams(location.search);
  if (form) {
    FIELDS.forEach((k) => {
      const value = init.get(k);
      if (!value) return;
      const el = form.elements.namedItem(k);
      if (el instanceof RadioNodeList) el.value = value;
      else if (el) (el as HTMLInputElement).value = value;
    });
    form.addEventListener('input', apply);
    apply();
  }
</script>
