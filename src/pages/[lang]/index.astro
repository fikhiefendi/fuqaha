---
import Base from '../../layouts/Base.astro';
import HeroSlider from '../../components/HeroSlider.astro';
import ArchSection from '../../components/ArchSection.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Cover from '../../components/Cover.astro';
import { formatDate, getFeatured, getPosts, postImage } from '../../lib/entries';
import { photo } from '../../lib/images';
import { getScholars, lifeShort } from '../../lib/scholars';
import { getWorks } from '../../lib/works';
import { langPaths, pick, useT, type Lang, type UIKey } from '../../i18n/ui';
import { href } from '../../lib/url';
import { WORK_TYPES } from '../../site.config';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);

const featured = await getFeatured(lang, 5);
const posts = (await getPosts(lang)).slice(0, 3);
const [lead, ...side] = posts;
const all = await getScholars();
const scholars = [...all.filter((s) => s.data.featured), ...all.filter((s) => !s.data.featured)].slice(0, 12);
const works = await getWorks();
const countOf = (k: string) => works.filter((w) => w.data.type === k).length;
// Types with records first, then the rest as "in preparation".
const types = Object.entries(WORK_TYPES)
  .map(([key, label]) => ({ key, label, n: countOf(key) }))
  .sort((a, b) => b.n - a.n)
  .slice(0, 6);
const placeCount = (await getCollection('places')).length;
const idrisi = photo('idrisi');
const num = new Intl.NumberFormat(lang === 'ar' ? 'ar' : lang === 'en' ? 'en-GB' : 'tr-TR');
---

<Base lang={lang} home>
  <HeroSlider
    lang={lang}
    items={featured}
    modules={[
      { href: href(lang, 'scholars/'), label: t('nav.scholars'), ar: 'التراجم' },
      { href: href(lang, 'timeline/'), label: t('nav.timeline' as UIKey), ar: 'الخريطة الزمنية' },
      { href: href(lang, 'map/'), label: t('nav.map'), ar: 'البلدان' },
      { href: href(lang, 'network/'), label: t('nav.network' as UIKey), ar: 'السلاسل' },
      { href: href(lang, 'bibliography/'), label: t('nav.bibliography'), ar: 'المصنفات' },
    ]}
  />

  <section class="section" id="main-sections">
    <div class="wrap">
      <div class="section-head">
        <h2>{t('home.posts')}</h2>
        <a href={href(lang, 'posts/')} class="btn small">{t('home.postsAll')}</a>
      </div>

      <div class="news">
        {
          lead && (
            <article class="news-lead">
              <a href={href(lang, `posts/${lead.slug}/`)} class="thumb" tabindex="-1" aria-hidden="true">
                <Cover seed={lead.slug} image={postImage(lead.entry, lang)?.src} alt={postImage(lead.entry, lang)?.alt} />
              </a>
              <div class="news-body">
                <h3 lang={lead.lang}>
                  <a href={href(lang, `posts/${lead.slug}/`)}>{lead.entry.data.title}</a>
                </h3>
                <p lang={lead.lang}>{lead.entry.data.summary}</p>
                <span class="date">
                  <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" /><path d="M8 4.5V8l2.5 1.5" fill="none" stroke="currentColor" /></svg>
                  {formatDate(lead.entry.data.date, lang)}
                </span>
                <a href={href(lang, `posts/${lead.slug}/`)} class="btn small">{t('readMore')}</a>
              </div>
            </article>
          )
        }
        <div class="news-side">
          {
            side.map((p) => (
              <article class="news-item">
                <a href={href(lang, `posts/${p.slug}/`)} class="thumb" tabindex="-1" aria-hidden="true">
                  <Cover seed={p.slug} image={postImage(p.entry, lang)?.src} alt={postImage(p.entry, lang)?.alt} />
                </a>
                <div class="news-body">
                  <h3 lang={p.lang}>
                    <a href={href(lang, `posts/${p.slug}/`)}>{p.entry.data.title}</a>
                  </h3>
                  <p lang={p.lang}>{p.entry.data.summary}</p>
                  <span class="date">
                    <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" /><path d="M8 4.5V8l2.5 1.5" fill="none" stroke="currentColor" /></svg>
                    {formatDate(p.entry.data.date, lang)}
                  </span>
                  <a href={href(lang, `posts/${p.slug}/`)} class="btn small">{t('readMore')}</a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <ArchSection
    lang={lang}
    title={t('nav.scholars')}
    lead={t('home.scholarsLead')}
    photo={photo('mabsut')}
    button={{ href: href(lang, 'scholars/'), label: t('home.scholarsAll') }}
    soft
  >
    {
      scholars.map((s) => (
        <a href={href(lang, `scholars/${s.id}/`)} class="mini-card">
          <span class="mini-ar" lang="ar">
            {s.data.name.ar}
          </span>
          {lang !== 'ar' && <span class="mini-title">{s.data.name[lang]}</span>}
          <span class="meta">{lifeShort(s, lang)}</span>
        </a>
      ))
    }
  </ArchSection>

  <section class="map-band">
    <Image src={idrisi.src} alt="" widths={[800, 1400, 2000]} sizes="100vw" class="map-bg" loading="lazy" />
    <div class="wrap map-inner">
      <div class="map-text">
        <span class="map-kicker">{t('nav.map')}</span>
        <h2>{t('home.mapTitle')}</h2>
        <p>{t('home.mapLead')}</p>
        <a href={href(lang, 'map/')} class="btn">{t('home.mapOpen')}</a>
      </div>
      <dl class="stats">
        <div><dt>{t('home.statScholars')}</dt><dd>{num.format(all.length)}</dd></div>
        <div><dt>{t('home.statPlaces')}</dt><dd>{num.format(placeCount)}</dd></div>
        <div><dt>{t('home.statWorks')}</dt><dd>{num.format(works.length)}</dd></div>
      </dl>
    </div>
    <p class="map-caption">{idrisi.caption[lang]}</p>
  </section>

  <ArchSection
    lang={lang}
    title={t('nav.bibliography')}
    lead={t('home.worksLead')}
    photo={photo('kharaj')}
    button={{ href: href(lang, 'bibliography/'), label: t('home.worksAll') }}
    flip
  >
    {
      types.map(({ key, label, n }) => (
        <a href={href(lang, n ? `bibliography/?type=${key}` : 'bibliography/')} class="mini-card">
          {n > 0 && <span class="mini-count">{num.format(n)}</span>}
          <span class="mini-title">{pick(label, lang)}</span>
          <span class="meta">{n > 0 ? t('bib.count') : t('soon')}</span>
        </a>
      ))
    }
  </ArchSection>
</Base>

<style>
  .news {
    display: grid;
    gap: 28px;
  }
  @media (min-width: 900px) {
    .news {
      grid-template-columns: 1.15fr 1fr;
    }
  }
  .thumb {
    display: block;
    overflow: hidden;
    background: var(--soft);
  }
  .thumb :global(.cover) {
    transition: transform 0.6s ease;
  }
  article:hover .thumb :global(.cover) {
    transform: scale(1.05);
  }
  .news-lead .thumb {
    aspect-ratio: 16 / 9;
  }
  .news-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .news-lead .news-body {
    padding-block-start: 22px;
  }
  .news-body h3 {
    font-size: 1.25rem;
  }
  .news-lead h3 {
    font-size: 1.5rem;
  }
  .news-body h3 a:hover {
    color: var(--accent);
  }
  .news-body p {
    font-size: 0.92rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :lang(ar) {
    line-height: 1.8;
  }
  .news-side {
    display: grid;
    gap: 28px;
    align-content: start;
  }
  .news-item {
    display: grid;
    grid-template-columns: minmax(140px, 42%) 1fr;
    gap: 20px;
  }
  .news-item .thumb {
    aspect-ratio: 4 / 5;
  }
  @media (max-width: 560px) {
    .news-item {
      grid-template-columns: 1fr;
    }
    .news-item .thumb {
      aspect-ratio: 16 / 9;
    }
  }

  .mini-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    min-height: 168px;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-block-start: 3px solid var(--accent);
    transition:
      transform 0.25s,
      box-shadow 0.25s,
      border-color 0.25s;
  }
  .mini-card:hover {
    transform: translateY(-3px);
    border-block-start-color: var(--rubric);
    box-shadow: 0 16px 30px -20px rgb(var(--shadow) / 0.5);
  }
  .mini-ar {
    font: 700 1.2rem/1.6 var(--arabic);
    color: var(--accent);
  }
  .mini-count {
    font: 600 2.1rem/1 var(--serif-latin);
    color: var(--accent);
  }
  .mini-title {
    font: 700 0.98rem/1.4 var(--serif);
    color: var(--ink);
  }

  .map-band {
    position: relative;
    overflow: hidden;
    padding-block: 110px 90px;
    background: #16130f;
    color: #fff;
  }
  .map-band :global(.map-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
  }
  .map-band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to right, rgb(22 17 11 / 0.88), rgb(22 17 11 / 0.55) 55%, rgb(22 17 11 / 0.25));
  }
  :root[dir='rtl'] .map-band::before {
    background: linear-gradient(to left, rgb(22 17 11 / 0.88), rgb(22 17 11 / 0.55) 55%, rgb(22 17 11 / 0.25));
  }
  .map-inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 48px;
    align-items: end;
  }
  @media (min-width: 900px) {
    .map-inner {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .map-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 500 0.82rem var(--sans);
    letter-spacing: 0.04em;
    color: rgb(255 255 255 / 0.8);
  }
  .map-kicker::before {
    content: '';
    width: 28px;
    height: 2px;
    background: #d9765c;
  }
  .map-text h2 {
    margin-block: 14px 12px;
    color: #fff;
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 600;
  }
  .map-text p {
    max-width: 46ch;
    margin-block-end: 28px;
    color: rgb(255 255 255 / 0.85);
  }
  .map-text .btn {
    background: #fff;
    color: var(--ink);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-block-start: 1px solid rgb(255 255 255 / 0.3);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding-block-start: 18px;
  }
  .stats dd {
    margin: 0;
    font: 600 clamp(2rem, 4vw, 3rem) / 1 var(--serif-latin);
    font-variant-numeric: lining-nums;
    color: #fff;
  }
  :root[lang='ar'] .stats dd {
    font-family: var(--arabic);
  }
  .stats dt {
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.75);
  }
  .map-caption {
    position: absolute;
    z-index: 2;
    inset-block-end: 18px;
    inset-inline-end: 32px;
    font: italic 400 0.74rem var(--sans);
    color: rgb(255 255 255 / 0.6);
  }
</style>
