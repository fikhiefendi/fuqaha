---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { photo } from '../../../lib/images';
import { getWorks, displayName, typeLabel, languageName, universityName } from '../../../lib/works';
import { langPaths, pick, useT, type Lang, type UIKey } from '../../../i18n/ui';
import { href, url } from '../../../lib/url';
import { WORK_TYPES } from '../../../site.config';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const k = (key: string) => t(key as UIKey);
const works = await getWorks();
const collator = new Intl.Collator('tr');
const counted = (xs: string[]) => {
  const m = new Map<string, number>();
  xs.forEach((x) => m.set(x, (m.get(x) ?? 0) + 1));
  return m;
};
const uniq = (xs: (string | undefined)[]) => [...new Set(xs.filter((x): x is string => !!x))].sort(collator.compare);
const types = Object.keys(WORK_TYPES).filter((key) => works.some((w) => w.data.type === key));
const languages = uniq(works.map((w) => w.data.language));
const universities = uniq(works.map((w) => universityName(w.data.university)));
const topics = uniq(works.flatMap((w) => w.data.topics));
const advisorCount = counted(works.flatMap((w) => w.data.advisors));
const advisors = [...advisorCount].sort((a, b) => b[1] - a[1] || collator.compare(a[0], b[0]));
const years = works.map((w) => w.data.year).filter((y): y is number => !!y);
const minYear = Math.min(...years);
const maxYear = Math.max(...years);
const num = new Intl.NumberFormat(lang === 'ar' ? 'ar' : lang === 'en' ? 'en-GB' : 'tr-TR');

const payload = {
  typeLabels: Object.fromEntries(types.map((key) => [key, pick(WORK_TYPES[key as keyof typeof WORK_TYPES], lang)])),
  langLabels: Object.fromEntries(languages.map((l) => [l, languageName(l, lang)])),
  locale: lang === 'ar' ? 'ar' : lang === 'en' ? 'en-GB' : 'tr-TR',
  listUrl: url('data/bibliography-list.json'),
  hrefBase: href(lang, 'bibliography/'),
  noYear: t('bib.noYear'),
  fullTextShort: k('bib.fullTextShort'),
  fullTextTitle: k('bib.fullText'),
};
---

<Base lang={lang} title={t('nav.bibliography')} description={t('bibliography.lead')}>
  <PageHead title={t('nav.bibliography')} lead={t('bibliography.lead')} photo={photo('multaqa')} lang={lang} />

  <div class="wrap page">
    <div class="layout">
      <form class="filters" data-filters onsubmit="return false" aria-label={k('bib.filters')}>
        <label>
          <span>{t('bib.search')}</span>
          <input type="search" name="q" placeholder={t('bib.searchPlaceholder')} autocomplete="off" />
        </label>
        <label>
          <span>{t('bib.type')}</span>
          <select name="type">
            <option value="">{t('bib.allTypes')}</option>
            {types.map((key) => <option value={key}>{pick(WORK_TYPES[key as keyof typeof WORK_TYPES], lang)}</option>)}
          </select>
        </label>
        <label>
          <span>{t('bib.university')}</span>
          <select name="uni">
            <option value="">{t('bib.allUniversities')}</option>
            {universities.map((u) => <option value={u}>{u}</option>)}
          </select>
        </label>
        <label>
          <span>{k('bib.advisor')}</span>
          <select name="adv">
            <option value="">{k('bib.allAdvisors')}</option>
            {advisors.map(([a, n]) => <option value={a}>{a} ({num.format(n)})</option>)}
          </select>
        </label>
        <label>
          <span>{t('bib.topic')}</span>
          <select name="topic">
            <option value="">{t('bib.allTopics')}</option>
            {topics.map((x) => <option value={x}>{x}</option>)}
          </select>
        </label>
        <label>
          <span>{t('bib.language')}</span>
          <select name="lang">
            <option value="">{t('bib.allLanguages')}</option>
            {languages.map((l) => <option value={l}>{languageName(l, lang)}</option>)}
          </select>
        </label>
        <div class="pair">
          <label>
            <span>{t('bib.yearFrom')}</span>
            <input type="number" name="from" min={minYear} max={maxYear} placeholder={String(minYear)} inputmode="numeric" />
          </label>
          <label>
            <span>{t('bib.yearTo')}</span>
            <input type="number" name="to" min={minYear} max={maxYear} placeholder={String(maxYear)} inputmode="numeric" />
          </label>
        </div>
        <label class="check"><input type="checkbox" name="abs" value="1" /> <span>{k('bib.hasAbstract')}</span></label>
        <label class="check"><input type="checkbox" name="pdf" value="1" /> <span>{k('bib.hasFullText')}</span></label>
        <button type="reset" class="reset">{t('bib.reset')}</button>
      </form>

      <div class="main">
        <div class="bar">
          <div class="tabs" role="tablist">
            <button type="button" role="tab" data-tab="records" aria-selected="true">{k('bib.tab.records')}</button>
            <button type="button" role="tab" data-tab="stats" aria-selected="false">{k('bib.tab.stats')}</button>
          </div>
          <p class="count" aria-live="polite"><strong data-count>{num.format(works.length)}</strong> {t('bib.count')}</p>
        </div>

        <section data-panel="records">
          <div class="tools">
            <div class="views" role="radiogroup" aria-label={k('bib.view')}>
              {
                [
                  ['list', 'M3 5h14M3 10h14M3 15h14'],
                  ['table', 'M2 4h16v12H2zM2 8h16M2 12h16M7 4v12'],
                  ['cards', 'M3 3h6v6H3zM11 3h6v6h-6zM3 11h6v6H3zM11 11h6v6h-6z'],
                  ['large', 'M2 3h16v6H2zM2 11h16v6H2z'],
                ].map(([v, d]) => (
                  <button type="button" role="radio" data-view={v} aria-checked={v === 'list' ? 'true' : 'false'} title={k(`bib.view.${v}`)}>
                    <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d={d} fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
                    <span>{k(`bib.view.${v}`)}</span>
                  </button>
                ))
              }
            </div>
            <label class="sort">
              <span>{t('bib.sort')}</span>
              <select name="sort" form="none" data-sort>
                <option value="year">{t('bib.sortYear')}</option>
                <option value="yearAsc">{t('bib.sortYearAsc')}</option>
                <option value="author">{t('bib.sortAuthor')}</option>
                <option value="title">{t('bib.sortTitle')}</option>
                <option value="uni">{k('bib.sortUni')}</option>
                <option value="pages">{k('bib.sortPages')}</option>
              </select>
            </label>
          </div>

          <div class="thead" aria-hidden="true">
            <button type="button" data-sort-by="year">{t('bib.year')}</button>
            <button type="button" data-sort-by="title">{k('bib.titleCol')}</button>
            <button type="button" data-sort-by="author">{t('bib.author')}</button>
            <span>{k('bib.advisor')}</span>
            <button type="button" data-sort-by="uni">{t('bib.university')}</button>
            <button type="button" data-sort-by="pages">{k('bib.pages')}</button>
          </div>

          <ol class="items" data-list data-view="list" aria-busy="true">
            {/* Rows are rendered in the browser from data/bibliography-list.json (see the script below). */}
          </ol>
          <noscript><p class="meta">{t('bib.export')}: <a href={url('data/bibliography.csv')}>CSV</a> · <a href={url('data/bibliography.json')}>JSON</a></p></noscript>
          <p class="none" hidden data-none>{t('bib.none')}</p>
          <div class="more" data-more-box>
            <button type="button" class="btn small plain" data-more>{k('bib.showMore')}</button>
            <button type="button" class="link-btn" data-all>{k('bib.showAll')}</button>
          </div>

          <div class="export" data-export={url('data/bibliography.json')}>
            <span>{t('bib.export')}:</span>
            <button type="button" data-format="bib">BibTeX</button>
            <button type="button" data-format="ris">RIS</button>
            <button type="button" data-format="csv">CSV</button>
            <span class="meta">{t('bib.exportNote')}</span>
          </div>
        </section>

        <section data-panel="stats" hidden>
          <p class="meta scope">{k('stats.scope')}</p>
          <div class="kpis" data-kpis></div>
          <figure class="chart">
            <figcaption>{k('stats.byYear')}</figcaption>
            <div class="years" data-years></div>
          </figure>
          <div class="bars-grid">
            <figure class="chart"><figcaption>{k('stats.topUniversities')}</figcaption><div data-bars="uni"></div></figure>
            <figure class="chart"><figcaption>{k('stats.topAdvisors')}</figcaption><div data-bars="adv"></div></figure>
            <figure class="chart"><figcaption>{k('stats.topTopics')}</figcaption><div data-bars="topic"></div></figure>
            <figure class="chart">
              <figcaption>{k('stats.byType')} · {k('stats.byLanguage')}</figcaption>
              <div data-bars="type"></div>
              <div data-bars="lang"></div>
            </figure>
          </div>
          <div class="tip" data-tip hidden></div>
        </section>

        <p class="source meta">{t('bib.source')}</p>
      </div>
    </div>
  </div>

  <script type="application/json" id="bib-data" set:html={JSON.stringify(payload)} />
  <template id="stat-labels">
    <span data-k="records">{k('stats.records')}</span>
    <span data-k="universities">{k('stats.universities')}</span>
    <span data-k="advisors">{k('stats.advisors')}</span>
    <span data-k="span">{k('stats.span')}</span>
    <span data-k="avgPages">{k('stats.avgPages')}</span>
    <span data-k="withAbstract">{k('stats.withAbstract')}</span>
    <span data-k="withFullText">{k('stats.withFullText')}</span>
    <span data-k="none">{k('stats.none')}</span>
  </template>
</Base>

<style>
  .page {
    padding-block-end: 80px;
  }
  .layout {
    display: grid;
    gap: 28px;
  }
  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: 250px minmax(0, 1fr);
      align-items: start;
    }
    .filters {
      position: sticky;
      top: calc(var(--header-h) + 16px);
      max-height: calc(100vh - var(--header-h) - 32px);
      overflow-y: auto;
    }
  }

  /* Filters */
  .filters {
    display: grid;
    gap: 14px;
    padding: 18px;
    background: var(--soft);
  }
  .filters label {
    display: grid;
    gap: 5px;
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--ink);
  }
  .filters input:not([type='checkbox']),
  .filters select,
  .sort select {
    width: 100%;
    padding: 9px 10px;
    border: 1px solid var(--rule);
    background: var(--surface);
    font: inherit;
    font-size: 0.88rem;
    color: var(--ink);
    border-radius: 0;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .filters .check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 400;
    cursor: pointer;
  }
  .check input {
    accent-color: var(--accent);
    width: 16px;
    height: 16px;
  }
  .reset,
  .link-btn {
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: 500 0.84rem var(--sans);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  /* Tabs, count, view switch */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 12px;
    border-block-end: 1px solid var(--rule);
  }
  .tabs {
    display: flex;
    gap: 4px;
  }
  .tabs button {
    padding: 10px 16px;
    border: 0;
    border-block-end: 2px solid transparent;
    background: none;
    color: var(--muted);
    font: 600 0.95rem var(--sans);
    cursor: pointer;
  }
  .tabs button[aria-selected='true'] {
    color: var(--ink);
    border-block-end-color: var(--rubric);
  }
  .count {
    padding-block-end: 10px;
    font-size: 0.88rem;
  }
  .count strong {
    color: var(--accent);
    font-size: 1.15rem;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 12px;
    margin-block: 16px 14px;
  }
  .views {
    display: flex;
    border: 1px solid var(--rule);
    background: var(--surface);
  }
  .views button {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 0;
    background: none;
    color: var(--muted);
    font: 500 0.82rem var(--sans);
    cursor: pointer;
  }
  .views button + button {
    border-inline-start: 1px solid var(--rule);
  }
  .views button[aria-checked='true'] {
    background: var(--accent);
    color: var(--on-accent);
  }
  .sort {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
  }
  .sort select {
    width: auto;
  }
  @media (max-width: 640px) {
    .views span {
      display: none;
    }
  }

  /* Items — one markup, four presentations */
  .items {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item[hidden],
  .item.paged {
    display: none !important;
  }
  .c-year,
  .c-adv,
  .c-uni,
  .c-pages,
  .c-author {
    display: none;
  }
  .c-kind {
    font: 600 0.68rem var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rubric);
  }
  :root[lang='ar'] .c-kind {
    letter-spacing: 0;
    font-size: 0.8rem;
  }
  .c-title {
    font: 600 1.02rem/1.4 var(--serif-latin);
    color: var(--ink);
  }
  .c-title:lang(ar) {
    font-family: var(--arabic);
  }
  .c-title:hover {
    color: var(--accent);
  }
  .c-meta,
  .c-topics {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .c-topics {
    color: var(--accent);
  }
  .c-abs {
    display: none;
    font: 400 0.9rem/1.65 var(--serif);
    color: var(--text);
  }
  .c-pdf {
    justify-self: start;
    align-self: flex-start;
    padding: 1px 7px;
    border: 1px solid var(--rubric);
    color: var(--rubric);
    font: 600 0.66rem/1.6 var(--sans);
    letter-spacing: 0.06em;
  }
  .c-pdf:hover {
    background: var(--rubric);
    color: var(--surface);
  }
  .item {
    position: relative;
  }


  /* Compact list */
  .items[data-view='list'] .item {
    display: grid;
    gap: 3px;
    padding-block: 14px;
    border-block-end: 1px solid var(--rule);
  }
  .items[data-view='list'] .c-topics,
  .items[data-view='list'] .c-pdf {
    display: none;
  }

  /* Wide table */
  .thead {
    display: none;
  }
  .page:has(.items[data-view='table']) .thead {
    display: grid;
  }
  .thead,
  .items[data-view='table'] .item {
    grid-template-columns: 56px minmax(0, 2.6fr) minmax(0, 1.1fr) minmax(0, 1.1fr) minmax(0, 1.2fr) 56px 40px;
    gap: 12px;
    align-items: baseline;
  }
  .thead {
    padding: 8px 10px;
    background: var(--soft);
    border-block-end: 2px solid var(--rule);
    font: 600 0.74rem var(--sans);
    color: var(--muted);
  }
  .thead button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .thead button:hover,
  .thead button[aria-sort] {
    color: var(--ink);
  }
  .thead button[aria-sort='descending']::after {
    content: ' ↓';
  }
  .thead button[aria-sort='ascending']::after {
    content: ' ↑';
  }
  .items[data-view='table'] .item {
    display: grid;
    padding: 9px 10px;
    border-block-end: 1px solid var(--rule);
    font-size: 0.84rem;
  }
  .items[data-view='table'] .item:nth-child(even) {
    background: color-mix(in srgb, var(--soft) 55%, transparent);
  }
  .items[data-view='table'] .item:hover {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .items[data-view='table'] :is(.c-year, .c-author, .c-adv, .c-uni, .c-pages) {
    display: block;
    color: var(--text);
  }
  .items[data-view='table'] .c-year,
  .items[data-view='table'] .c-pages {
    font-variant-numeric: tabular-nums;
  }
  .items[data-view='table'] .c-title {
    font-size: 0.92rem;
  }
  .items[data-view='table'] :is(.c-kind, .c-meta, .c-topics, .c-abs) {
    display: none;
  }
  .items[data-view='table'] .c-year {
    order: 0;
  }
  .items[data-view='table'] .c-title {
    order: 1;
  }
  .items[data-view='table'] .c-author {
    order: 2;
  }
  .items[data-view='table'] .c-adv {
    order: 3;
  }
  .items[data-view='table'] .c-uni {
    order: 4;
  }
  .items[data-view='table'] .c-pages {
    order: 5;
  }
  .items[data-view='table'] .c-pdf {
    order: 6;
  }
  @media (max-width: 860px) {
    .thead,
    .items[data-view='table'] .item {
      grid-template-columns: 48px minmax(0, 1fr) 40px;
    }
    .thead :nth-child(n + 3):not(:last-child),
    .items[data-view='table'] :is(.c-author, .c-adv, .c-uni, .c-pages) {
      display: none;
    }
  }

  /* Cards */
  .items[data-view='cards'],
  .items[data-view='large'] {
    display: grid;
    gap: 14px;
  }
  .items[data-view='cards'] {
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  .items[data-view='large'] {
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 18px;
  }
  :is(.items[data-view='cards'], .items[data-view='large']) .item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-block-start: 3px solid var(--accent);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  :is(.items[data-view='cards'], .items[data-view='large']) .item:hover {
    border-block-start-color: var(--rubric);
    transform: translateY(-2px);
  }
  .items[data-view='cards'] .c-title {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.95rem;
  }
  .items[data-view='cards'] .c-meta {
    margin-block-start: auto;
  }
  .items[data-view='cards'] .c-topics,
  .items[data-view='cards'] .c-pdf {
    display: none;
  }
  .items[data-view='large'] .item {
    padding: 20px;
  }
  .items[data-view='large'] .c-title {
    font-size: 1.1rem;
  }
  .items[data-view='large'] .c-abs {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .items[data-view='large'] .c-adv:not(:empty) {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .items[data-view='large'] .c-adv:not(:empty)::before {
    content: attr(data-label);
  }
  .items[data-view='large'] .c-pdf {
    margin-block-start: auto;
  }

  .none {
    padding: 24px 0;
  }
  .more {
    display: flex;
    align-items: center;
    gap: 18px;
    justify-content: center;
    margin-block: 26px 10px;
  }
  .more[hidden] {
    display: none;
  }
  .export {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin-block-start: 28px;
    padding-block-start: 14px;
    border-block-start: 1px solid var(--rule);
    font-size: 0.85rem;
  }
  .export button {
    padding: 6px 14px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: transparent;
    color: var(--accent);
    font: 500 0.82rem var(--sans);
    cursor: pointer;
  }
  .export button:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .export .meta {
    flex-basis: 100%;
  }
  .source {
    margin-block-start: 28px;
  }

  /* Statistics */
  .scope {
    margin-block: 16px;
  }
  .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 10px;
  }
  .kpis :global(div) {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-block-start: 3px solid var(--chart);
  }
  .kpis :global(strong) {
    font: 600 1.7rem/1.1 var(--serif-latin);
    color: var(--ink);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .kpis :global(span) {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .chart {
    margin: 28px 0 0;
  }
  figcaption {
    margin-block-end: 12px;
    font: 600 1rem var(--serif);
    color: var(--ink);
  }
  .years {
    position: relative;
    overflow-x: auto;
  }
  .years :global(svg) {
    display: block;
    max-width: none;
  }
  .years :global(.col) {
    fill: var(--chart);
    cursor: pointer;
  }
  .years :global(.col:hover),
  .years :global(.col:focus-visible) {
    fill: var(--accent-dark);
    outline: none;
  }
  .years :global(.grid) {
    stroke: var(--rule);
  }
  .years :global(text) {
    font: 400 10.5px var(--sans);
    fill: var(--muted);
  }
  .bars-grid {
    display: grid;
    gap: 8px 36px;
  }
  @media (min-width: 900px) {
    .bars-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  [data-bars] :global(button) {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--text);
    font: 400 0.82rem var(--sans);
    text-align: start;
    cursor: pointer;
  }
  [data-bars] :global(.lbl) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  [data-bars] :global(.trk) {
    height: 10px;
  }
  [data-bars] :global(.fill) {
    display: block;
    height: 100%;
    min-width: 2px;
    background: var(--chart);
    border-radius: 0 4px 4px 0;
  }
  :root[dir='rtl'] [data-bars] :global(.fill) {
    border-radius: 4px 0 0 4px;
  }
  [data-bars] :global(.val) {
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    font-weight: 600;
  }
  [data-bars] :global(button:hover .fill),
  [data-bars] :global(button:focus-visible .fill) {
    background: var(--accent-dark);
  }
  [data-bars] :global(button:hover .lbl) {
    color: var(--ink);
  }
  [data-bars] + [data-bars] {
    margin-block-start: 14px;
  }
  .tip {
    position: fixed;
    z-index: 50;
    padding: 6px 10px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.8rem;
    pointer-events: none;
  }
  .tip :global(strong) {
    font-size: 0.95rem;
  }
</style>

<script>
  import { toBibtex, toCsv, toRis, type Rec } from '../../../lib/cite';

  const meta = JSON.parse(document.getElementById('bib-data')!.textContent!) as {
    typeLabels: Record<string, string>;
    langLabels: Record<string, string>;
    locale: string;
    listUrl: string;
    hrefBase: string;
    noYear: string;
    fullTextShort: string;
    fullTextTitle: string;
  };
  /** See src/pages/data/bibliography-list.json.ts */
  type Row = [string, string, string, string, string, string[], string[], number | null, number | null, 0 | 1, string, string, string, string, string];
  const label = (key: string) => document.querySelector<HTMLElement>(`#stat-labels`)!.content.querySelector<HTMLElement>(`[data-k="${key}"]`)!.textContent!;
  const nf = new Intl.NumberFormat(meta.locale);
  const PAGE = 50;

  async function main() {

  const form = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const list = document.querySelector<HTMLOListElement>('[data-list]')!;
  // Build the rows. Elements created here carry the same scoped-style attribute as the list.
  const scope = [...list.attributes].map((x) => x.name).find((n) => n.startsWith('data-astro-cid-'));
  const scopeClass = [...list.classList].find((c) => c.startsWith('astro-'));
  const make = <K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string) => {
    const e = document.createElement(tag);
    e.className = scopeClass ? `${cls} ${scopeClass}` : cls;
    if (scope) e.setAttribute(scope, '');
    if (text !== undefined) e.textContent = text;
    return e;
  };
  const rowFmt = new Intl.NumberFormat(meta.locale);
  const rows = (await (await fetch(meta.listUrl)).json()) as Row[];
  const frag = document.createDocumentFragment();
  for (const [id, type, lang, uni, uniFull, adv, topics, year, pages, abs, pdf, title, authors, city, snip] of rows) {
    const li = make('li', 'item');
    Object.assign(li.dataset, {
      id,
      type,
      lang,
      uni,
      adv: adv.join('|'),
      topics: topics.join('|'),
      year: year ? String(year) : '',
      pages: pages ? String(pages) : '',
      abs: String(abs),
      pdf: pdf ? '1' : '0',
    });
    const a = make('a', 'c-title', title);
    a.href = `${meta.hrefBase}${id}/`;
    a.lang = lang;
    const u = make('span', 'c-uni', uni);
    u.title = uniFull;
    li.append(
      make('span', 'c-year', year ? String(year) : '—'),
      make('span', 'c-kind', meta.typeLabels[type] ?? type),
      a,
      make('span', 'c-author', authors),
      make('span', 'c-adv', adv.join(', ')),
      u,
      make('span', 'c-pages', pages ? rowFmt.format(pages) : ''),
      make('span', 'c-meta', [authors, uni, city, year ?? meta.noYear].filter(Boolean).join(' · ')),
    );
    if (snip) {
      const p = make('p', 'c-abs', snip);
      p.lang = lang;
      li.append(p);
    }
    if (topics.length) li.append(make('span', 'c-topics', topics.join(' · ')));
    if (pdf) {
      const l = make('a', 'c-pdf', meta.fullTextShort);
      l.href = pdf;
      l.rel = 'noopener';
      l.target = '_blank';
      l.title = meta.fullTextTitle;
      li.append(l);
    }
    frag.append(li);
  }
  list.append(frag);
  list.removeAttribute('aria-busy');
  const items = [...list.querySelectorAll<HTMLLIElement>('.item')];
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const none = document.querySelector<HTMLElement>('[data-none]')!;
  const moreBox = document.querySelector<HTMLElement>('[data-more-box]')!;
  const sortSel = document.querySelector<HTMLSelectElement>('[data-sort]')!;
  const fold = (s: string) =>
    s
      .toLocaleLowerCase('tr')
      .normalize('NFD')
      .replace(/[̀-ͯ']/g, '')
      .replace(/[ıİ]/g, 'i');
  // Search, author and title keys come from the text already on the page.
  const text = (li: HTMLLIElement, sel: string) => li.querySelector(sel)?.textContent ?? '';
  items.forEach((li) => {
    li.dataset.author = fold(text(li, '.c-author'));
    li.dataset.title = fold(text(li, '.c-title'));
  });
  const keys = items.map((li) => fold(li.textContent ?? ''));
  const collator = new Intl.Collator('tr');
  const sorters: Record<string, (a: HTMLLIElement, b: HTMLLIElement) => number> = {
    year: (a, b) => Number(b.dataset.year || 0) - Number(a.dataset.year || 0),
    yearAsc: (a, b) => Number(a.dataset.year || 9999) - Number(b.dataset.year || 9999),
    author: (a, b) => collator.compare(a.dataset.author ?? '', b.dataset.author ?? ''),
    title: (a, b) => collator.compare(a.dataset.title ?? '', b.dataset.title ?? ''),
    uni: (a, b) => collator.compare(a.dataset.uni ?? '', b.dataset.uni ?? '') || Number(b.dataset.year || 0) - Number(a.dataset.year || 0),
    pages: (a, b) => Number(b.dataset.pages || 0) - Number(a.dataset.pages || 0),
  };
  // Label the supervisor line in large cards without repeating markup.
  const advLabel = document.querySelector('.thead span')?.textContent ?? '';
  items.forEach((li) => li.querySelector('.c-adv')?.setAttribute('data-label', `${advLabel}: `));

  const FIELDS = ['q', 'type', 'lang', 'uni', 'adv', 'topic', 'from', 'to', 'abs', 'pdf'];
  let limit = PAGE;
  let view = 'list';
  let tab = 'records';
  let shown: HTMLLIElement[] = [];

  const apply = (resetLimit = true) => {
    const d = new FormData(form);
    const v = (key: string) => String(d.get(key) ?? '').trim();
    const q = fold(v('q'));
    const from = Number(v('from')) || 0;
    const to = Number(v('to')) || 0;
    if (resetLimit) limit = PAGE;
    shown = [];
    items.forEach((li, i) => {
      const y = Number(li.dataset.year || 0);
      const ok =
        (!q || q.split(/\s+/).every((w) => keys[i].includes(w))) &&
        (!v('type') || li.dataset.type === v('type')) &&
        (!v('lang') || li.dataset.lang === v('lang')) &&
        (!v('uni') || li.dataset.uni === v('uni')) &&
        (!v('adv') || (li.dataset.adv ?? '').split('|').includes(v('adv'))) &&
        (!v('topic') || (li.dataset.topics ?? '').split('|').includes(v('topic'))) &&
        (!from || (y && y >= from)) &&
        (!to || (y && y <= to)) &&
        (!v('abs') || li.dataset.abs === '1') &&
        (!v('pdf') || li.dataset.pdf === '1');
      li.hidden = !ok;
      if (ok) shown.push(li);
    });
    const sort = sortSel.value || 'year';
    shown.sort(sorters[sort]);
    list.append(...shown, ...items.filter((li) => li.hidden));
    shown.forEach((li, i) => li.classList.toggle('paged', i >= limit));
    count.textContent = nf.format(shown.length);
    none.hidden = shown.length > 0;
    moreBox.hidden = shown.length <= limit;
    document.querySelectorAll<HTMLButtonElement>('[data-sort-by]').forEach((b) => {
      const s = b.dataset.sortBy!;
      const on = sort === s || (s === 'year' && sort === 'yearAsc');
      on ? b.setAttribute('aria-sort', sort === 'yearAsc' || s === 'author' || s === 'title' || s === 'uni' ? 'ascending' : 'descending') : b.removeAttribute('aria-sort');
    });

    const params = new URLSearchParams();
    FIELDS.forEach((key) => v(key) && params.set(key, v(key)));
    if (sort !== 'year') params.set('sort', sort);
    if (view !== 'list') params.set('view', view);
    if (tab !== 'records') params.set('tab', tab);
    history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
    if (tab === 'stats') renderStats();
  };

  /* Views and tabs */
  const setView = (next: string) => {
    view = next;
    list.dataset.view = next;
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.view === next)));
    try {
      localStorage.setItem('bib-view', next);
    } catch {
      /* the choice lasts for this page only */
    }
    apply(false);
  };
  document.querySelectorAll<HTMLButtonElement>('button[data-view]').forEach((b) => b.addEventListener('click', () => setView(b.dataset.view!)));
  const setTab = (next: string) => {
    tab = next;
    document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === next)));
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== next));
    apply(false);
  };
  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => setTab(b.dataset.tab!)));
  document.querySelectorAll<HTMLButtonElement>('[data-sort-by]').forEach((b) =>
    b.addEventListener('click', () => {
      const s = b.dataset.sortBy!;
      sortSel.value = s === 'year' && sortSel.value === 'year' ? 'yearAsc' : s;
      apply(false);
    }),
  );
  sortSel.addEventListener('change', () => apply(false));
  document.querySelector('[data-more]')!.addEventListener('click', () => {
    limit += PAGE;
    apply(false);
  });
  document.querySelector('[data-all]')!.addEventListener('click', () => {
    limit = Infinity;
    apply(false);
  });

  /* Statistics — every figure is computed from the records the filters leave */
  const tip = document.querySelector<HTMLElement>('[data-tip]')!;
  const showTip = (e: PointerEvent | FocusEvent, value: string, name: string) => {
    tip.replaceChildren();
    const strong = document.createElement('strong');
    strong.textContent = value;
    tip.append(strong, document.createTextNode(` · ${name}`));
    tip.hidden = false;
    const r = (e.target as Element).getBoundingClientRect();
    tip.style.left = `${Math.min(r.left + r.width / 2 - tip.offsetWidth / 2, innerWidth - tip.offsetWidth - 8)}px`;
    tip.style.top = `${r.top - tip.offsetHeight - 8}px`;
  };
  const hideTip = () => (tip.hidden = true);

  const setFilter = (name: string, value: string) => {
    const el = form.elements.namedItem(name) as HTMLSelectElement | HTMLInputElement;
    el.value = value;
    if (name === 'from') (form.elements.namedItem('to') as HTMLInputElement).value = value;
    apply();
  };

  const tally = (pick: (li: HTMLLIElement) => string[]) => {
    const m = new Map<string, number>();
    shown.forEach((li) => pick(li).forEach((x) => x && m.set(x, (m.get(x) ?? 0) + 1)));
    return [...m].sort((a, b) => b[1] - a[1] || collator.compare(a[0], b[0]));
  };

  const bars = (el: HTMLElement, rows: [string, number][], filter: string, name: (x: string) => string) => {
    el.replaceChildren();
    const max = Math.max(1, ...rows.map(([, n]) => n));
    rows.slice(0, 10).forEach(([key, n]) => {
      const b = document.createElement('button');
      b.type = 'button';
      const lbl = document.createElement('span');
      lbl.className = 'lbl';
      lbl.textContent = name(key);
      lbl.title = name(key);
      const trk = document.createElement('span');
      trk.className = 'trk';
      const fill = document.createElement('span');
      fill.className = 'fill';
      fill.style.width = `${(n / max) * 100}%`;
      trk.append(fill);
      const val = document.createElement('span');
      val.className = 'val';
      val.textContent = nf.format(n);
      b.append(lbl, trk, val);
      b.addEventListener('click', () => setFilter(filter, key));
      el.append(b);
    });
  };

  const renderStats = () => {
    const kpis = document.querySelector<HTMLElement>('[data-kpis]')!;
    kpis.replaceChildren();
    if (!shown.length) {
      const p = document.createElement('div');
      p.textContent = label('none');
      kpis.append(p);
    }
    const ys = shown.map((li) => Number(li.dataset.year)).filter(Boolean);
    const pages = shown.map((li) => Number(li.dataset.pages)).filter(Boolean);
    const pct = (n: number) => `${Math.round((n / Math.max(1, shown.length)) * 100)}%`;
    const tiles: [string, string][] = [
      [nf.format(shown.length), label('records')],
      [nf.format(tally((li) => [li.dataset.uni ?? '']).length), label('universities')],
      [nf.format(tally((li) => (li.dataset.adv ?? '').split('|')).length), label('advisors')],
      [ys.length ? `${Math.min(...ys)}–${Math.max(...ys)}` : '—', label('span')],
      [pages.length ? nf.format(Math.round(pages.reduce((a, b) => a + b, 0) / pages.length)) : '—', label('avgPages')],
      [pct(shown.filter((li) => li.dataset.abs === '1').length), label('withAbstract')],
      [pct(shown.filter((li) => li.dataset.pdf === '1').length), label('withFullText')],
    ];
    if (shown.length)
      tiles.forEach(([v, l]) => {
        const div = document.createElement('div');
        const s = document.createElement('strong');
        s.textContent = v;
        const sp = document.createElement('span');
        sp.textContent = l;
        div.append(s, sp);
        kpis.append(div);
      });

    // Theses per year: one column per year, a gridline every 10.
    const box = document.querySelector<HTMLElement>('[data-years]')!;
    const perYear = new Map<number, number>();
    ys.forEach((y) => perYear.set(y, (perYear.get(y) ?? 0) + 1));
    box.replaceChildren();
    if (ys.length) {
      const y0 = Math.min(...ys);
      const y1 = Math.max(...ys);
      const H = 180;
      const PADL = 34;
      const W = Math.max(box.clientWidth, 320);
      const colW = Math.max(4, (W - PADL - 8) / (y1 - y0 + 1));
      const max = Math.max(...perYear.values());
      const step = max > 40 ? 20 : max > 16 ? 10 : max > 6 ? 5 : 2;
      const sy = (n: number) => H - (n / (Math.ceil(max / step) * step)) * (H - 10);
      const ns = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(ns, 'svg');
      svg.setAttribute('width', String(W));
      svg.setAttribute('height', String(H + 26));
      svg.setAttribute('role', 'img');
      for (let v = 0; v <= Math.ceil(max / step) * step; v += step) {
        const line = document.createElementNS(ns, 'line');
        line.setAttribute('class', 'grid');
        line.setAttribute('x1', String(PADL));
        line.setAttribute('x2', String(W));
        line.setAttribute('y1', String(sy(v)));
        line.setAttribute('y2', String(sy(v)));
        const tx = document.createElementNS(ns, 'text');
        tx.setAttribute('x', String(PADL - 6));
        tx.setAttribute('y', String(sy(v) + 3));
        tx.setAttribute('text-anchor', 'end');
        tx.textContent = nf.format(v);
        svg.append(line, tx);
      }
      for (let y = y0; y <= y1; y++) {
        const x = PADL + (y - y0) * colW + 2;
        const n = perYear.get(y) ?? 0;
        if (y % (colW < 9 ? 10 : 5) === 0) {
          const tx = document.createElementNS(ns, 'text');
          tx.setAttribute('x', String(x + (colW - 2) / 2));
          tx.setAttribute('y', String(H + 16));
          tx.setAttribute('text-anchor', 'middle');
          tx.textContent = String(y);
          svg.append(tx);
        }
        if (!n) continue;
        const top = sy(n);
        const w = colW - 2;
        const r = Math.min(4, w / 2, H - top);
        const path = document.createElementNS(ns, 'path');
        path.setAttribute('class', 'col');
        path.setAttribute('d', `M${x} ${H}V${top + r}Q${x} ${top} ${x + r} ${top}H${x + w - r}Q${x + w} ${top} ${x + w} ${top + r}V${H}Z`);
        path.setAttribute('tabindex', '0');
        path.setAttribute('aria-label', `${y}: ${nf.format(n)}`);
        path.addEventListener('pointerenter', (e) => showTip(e, nf.format(n), String(y)));
        path.addEventListener('focus', (e) => showTip(e, nf.format(n), String(y)));
        path.addEventListener('pointerleave', hideTip);
        path.addEventListener('blur', hideTip);
        path.addEventListener('click', () => setFilter('from', String(y)));
        svg.append(path);
      }
      box.append(svg);
    }

    bars(document.querySelector('[data-bars="uni"]')!, tally((li) => [li.dataset.uni ?? '']), 'uni', (x) => x);
    bars(document.querySelector('[data-bars="adv"]')!, tally((li) => (li.dataset.adv ?? '').split('|')), 'adv', (x) => x);
    bars(document.querySelector('[data-bars="topic"]')!, tally((li) => (li.dataset.topics ?? '').split('|')), 'topic', (x) => x);
    bars(document.querySelector('[data-bars="type"]')!, tally((li) => [li.dataset.type ?? '']), 'type', (x) => meta.typeLabels[x] ?? x);
    bars(document.querySelector('[data-bars="lang"]')!, tally((li) => [li.dataset.lang ?? '']), 'lang', (x) => meta.langLabels[x] ?? x);
  };

  /* Export the filtered records */
  let cache: Rec[] | undefined;
  const exporter = document.querySelector<HTMLElement>('[data-export]')!;
  exporter.querySelectorAll<HTMLButtonElement>('[data-format]').forEach((b) =>
    b.addEventListener('click', async () => {
      cache ??= (await (await fetch(exporter.dataset.export!)).json()) as Rec[];
      const order = new Map(shown.map((li, i) => [li.dataset.id, i]));
      const recs = cache.filter((r) => order.has(r.id)).sort((a, b) => order.get(a.id)! - order.get(b.id)!);
      const format = b.dataset.format!;
      const text = format === 'bib' ? recs.map(toBibtex).join('\n\n') : format === 'ris' ? recs.map(toRis).join('\r\n') : toCsv(recs);
      const type = { bib: 'application/x-bibtex', ris: 'application/x-research-info-systems', csv: 'text/csv' }[format];
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([text], { type: `${type};charset=utf-8` }));
      a.download = `fuqaha-bibliyografya.${format}`;
      a.click();
      URL.revokeObjectURL(a.href);
    }),
  );

  /* Restore state from the address, then from the last visit */
  const init = new URLSearchParams(location.search);
  FIELDS.forEach((key) => {
    const el = form.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement | null;
    const value = init.get(key);
    if (!el || !value) return;
    if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = true;
    else el.value = value;
  });
  if (init.get('sort')) sortSel.value = init.get('sort')!;
  let saved = 'list';
  try {
    saved = localStorage.getItem('bib-view') ?? 'list';
  } catch {
    /* no stored preference */
  }
  view = init.get('view') ?? saved;
  list.dataset.view = view;
  document.querySelectorAll<HTMLButtonElement>('button[data-view]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.view === view)));
  if (init.get('tab') === 'stats') setTab('stats');
  form.addEventListener('input', () => apply());
  form.addEventListener('reset', () => setTimeout(() => apply()));
  apply(false);
  }

  main();
</script>
